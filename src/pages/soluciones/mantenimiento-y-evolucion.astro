---
import SolutionPage from "@/components/SolutionPage.astro";

const outcomes = [
  {
    title: "Modalidades claras: preventivo, correctivo y evolutivo",
    description:
      "Definimos con precisión el alcance de cada modalidad: mantenimiento preventivo (seguridad y copias de seguridad), correctivo (atención de caídas y errores urgentes) y evolutivo (desarrollo de nuevas funciones y mejoras continuas).",
  },
  {
    title: "Protección constante contra vulnerabilidades y pérdida de datos",
    description:
      "Los sitios y sistemas sin actualizar son el blanco principal de ciberataques. Aplicamos parches de seguridad, renovamos certificados SSL y programamos respaldos periódicos en servidores externos para que tu información nunca se pierda.",
  },
  {
    title: "Resolución rápida de incidencias que detienen tus ventas",
    description:
      "Un formulario roto, una pasarela de pago desconfigurada o un error 500 en tu tienda online significa dinero perdido. Cuentas con un canal de atención directa con un desarrollador para resolver fallas técnicas con prioridad.",
  },
  {
    title: "Mejora continua sin tener que rehacer la web cada dos años",
    description:
      "En lugar de esperar a que tu plataforma quede obsoleta para reconstruirla desde cero, adaptamos el código, mejoramos tiempos de carga y agregamos nuevas integraciones a medida que tu empresa crece.",
  },
];

const capabilities = [
  {
    title: "Mantenimiento preventivo y monitoreo de disponibilidad (Uptime)",
    description:
      "Supervisión continua para detectar caídas del servidor antes de que tus clientes lo noten, optimizando estabilidad de infraestructura.",
  },
  {
    title: "Copias de seguridad periódicas (Backups externos)",
    description:
      "Generación y resguardo seguro de bases de datos y archivos en la nube, listos para restauración inmediata ante cualquier contingencia.",
  },
  {
    title: "Soporte correctivo y resolución de errores",
    description:
      "Diagnóstico y corrección de bugs, problemas de visualización en celulares, enlaces caídos y fallas en envío de correos o formularios.",
  },
  {
    title: "Actualización de frameworks, librerías y dependencias",
    description:
      "Mantenimiento de tecnologías modernas al día, evitando incompatibilidades de software y reduciendo brechas de seguridad.",
  },
  {
    title: "Optimización continua de velocidad y Core Web Vitals",
    description:
      "Depuración periódica de código, optimización de caché, compresión de nuevos archivos multimedia y auditorías de rendimiento.",
  },
  {
    title: "Desarrollo de mejoras evolutivas",
    description:
      "Implementación de nuevas páginas de servicios, ajuste de textos comerciales, cambios de diseño y conexión con nuevas herramientas digitales.",
  },
];

const steps = [
  {
    title: "Auditoría técnica inicial del sitio o sistema",
    description:
      "Revisamos el código, la infraestructura, la velocidad, los errores en consola y las vulnerabilidades existentes para conocer el estado real de la plataforma.",
  },
  {
    title: "Estabilización, limpieza y configuración de seguridad",
    description:
      "Corregimos los fallos urgentes detectados, configuramos copias de seguridad automatizadas y optimizamos la configuración del servidor.",
  },
  {
    title: "Acompañamiento mensual y evolución programada",
    description:
      "Monitoreamos el funcionamiento continuo y ejecutamos una bolsa de horas asignada a mejoras, cambios y soporte técnico directo.",
  },
];

const related = [
  {
    title: "Desarrollo web corporativo",
    description:
      "Diseño y construcción de páginas web modernas con código limpio, rápido y preparado para posicionar.",
    href: "/soluciones/desarrollo-web",
  },
  {
    title: "Software a medida y sistemas web",
    description:
      "Sistemas empresariales y paneles administrativos adaptados a la operación real de tu negocio.",
    href: "/soluciones/software-a-medida",
  },
  {
    title: "Automatización de procesos",
    description:
      "Conecta tus herramientas actuales y elimina tareas repetitivas mediante flujos automáticos.",
    href: "/soluciones/automatizacion-de-procesos",
  },
];

const faqs = [
  {
    question: "¿Qué incluye y qué no incluye el servicio de mantenimiento?",
    answer:
      "Incluye monitoreo, copias de seguridad periódicas, parches de seguridad, corrección de errores imprevistos y una cantidad mensual acordada de horas para cambios o nuevas funcionalidades. No incluye los costos directos de proveedores de hosting/dominio (que se pagan directamente al proveedor) ni la reconstrucción completa de un sistema desde cero bajo una tarifa básica.",
  },
  {
    question: "¿Pueden mantener una página web o sistema desarrollado por otro programador?",
    answer:
      "Sí. Primero realizamos un diagnóstico técnico para evaluar la calidad del código, las tecnologías utilizadas y la arquitectura. Si el sistema es técnicamente viable y seguro, asumimos el soporte y proponemos mejoras prioritarias.",
  },
  {
    question: "¿Es obligatorio contratar un plan mensual después de lanzar un proyecto con Velyon?",
    answer:
      "No es obligatorio. En VelyonSoft entregamos código limpio y totalmente documentado, por lo que tu sitio puede operar sin mensualidades forzosas. Sin embargo, muchas empresas prefieren delegarnos el soporte técnico para enfocarse en sus operaciones comerciales con tranquilidad.",
  },
  {
    question: "¿Con qué rapidez atienden una caída o problema urgente?",
    answer:
      "Para emergencias críticas (como caídas totales del sitio o fallos en pasarelas de pago), nuestros clientes de mantenimiento cuentan con canales directos en WhatsApp con tiempos de respuesta priorizados en horario laboral.",
  },
  {
    question: "¿Qué ocurre con las horas de soporte que no se utilicen en un mes?",
    answer:
      "Las horas pueden utilizarse para tareas de mantenimiento preventivo, revisiones de seguridad, optimización de velocidad o acumularse parcialmente según las condiciones específicas acordadas en la propuesta de servicio.",
  },
];
---

<SolutionPage
  eyebrow="Solución · Mantenimiento web y soporte de software"
  title="Soporte técnico, seguridad y evolución continua para"
  highlight="páginas web y sistemas."
  description="Brindamos servicios de mantenimiento preventivo, correctivo y evolutivo para páginas web, tiendas online y sistemas en Perú y Latinoamérica. Mantén tu plataforma rápida, blindada contra caídas y adaptada al crecimiento de tu empresa."
  metaTitle="Mantenimiento Web y Soporte Continuo de Software en Perú y LATAM | VelyonSoft"
  metaDescription="Servicio de mantenimiento web, soporte técnico y evolución continua de software para empresas en Perú y Latinoamérica. Seguridad, copias de seguridad, resolución de errores y optimización."
  path="/soluciones/mantenimiento-y-evolucion"
  lottieSrc="/animations/mantenimiento-evolutivo.lottie"
  introTitle="Un proyecto digital en producción requiere cuidado técnico constante para no depreciarse."
  intro="Al igual que una maquinaria física, un software o sitio web requiere mantenimiento técnico periódico: las librerías se actualizan, los navegadores cambian sus estándares y surgen nuevas amenazas de seguridad. Brindamos un acompañamiento transparente y directo con el desarrollador para que nunca te quedes sin respaldo técnico."
  outcomes={outcomes}
  capabilities={capabilities}
  deliverables={[
    "Diagnóstico técnico y auditoría inicial de seguridad",
    "Configuración de monitoreo de disponibilidad 24/7",
    "Copias de seguridad automáticas y externas",
    "Canal directo de soporte técnico por WhatsApp",
    "Resolución prioritaria de errores y bugs",
    "Optimización de velocidad y Core Web Vitals",
    "Bolsa mensual de horas para cambios y mejoras",
    "Reporte mensual de tareas técnicas ejecutadas",
  ]}
  steps={steps}
  related={related}
  faqs={faqs}
/>