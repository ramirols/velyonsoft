---
import SolutionPage from "@/components/SolutionPage.astro";

const outcomes = [
    {
        title: "Conecta tu negocio con tus clientes desde el celular",
        description:
            "Creamos aplicaciones móviles que permiten ofrecer servicios, vender productos o mejorar la comunicación con tus usuarios.",
    },
    {
        title: "Digitaliza procesos que ocurren fuera de la oficina",
        description:
            "Permite que equipos comerciales, técnicos o de campo registren información y trabajen desde cualquier lugar.",
    },
    {
        title: "Mejora la experiencia del usuario",
        description:
            "Diseñamos aplicaciones rápidas e intuitivas que facilitan tareas frecuentes y generan una mejor interacción.",
    },
    {
        title: "Construcción por etapas",
        description:
            "Iniciamos con una primera versión funcional y evolucionamos la aplicación según resultados y necesidades reales.",
    },
];

const capabilities = [
    {
        title: "Aplicaciones Android e iOS",
        description:
            "Desarrollo de aplicaciones móviles personalizadas para usuarios, clientes o equipos internos.",
    },
    {
        title: "Aplicaciones empresariales",
        description:
            "Soluciones móviles para gestionar operaciones, ventas, servicios y procesos internos.",
    },
    {
        title: "Integración con sistemas existentes",
        description:
            "Conectamos la aplicación con bases de datos, plataformas web y herramientas actuales mediante integraciones seguras.",
    },
    {
        title: "Notificaciones y comunicación",
        description:
            "Implementamos avisos, recordatorios y mensajes automáticos para mejorar la interacción.",
    },
    {
        title: "Funcionamiento sin conexión",
        description:
            "Diseñamos experiencias que permiten registrar información incluso en lugares con conectividad limitada.",
    },
    {
        title: "Panel administrativo",
        description:
            "Creamos herramientas web para gestionar usuarios, información, contenido y métricas de la aplicación.",
    },
];

const steps = [
    {
        title: "Definimos la idea y objetivos",
        description:
            "Analizamos usuarios, necesidades y procesos para determinar qué tipo de aplicación realmente necesita tu negocio.",
    },
    {
        title: "Diseño y desarrollo inicial",
        description:
            "Creamos la experiencia visual y construimos una primera versión funcional preparada para pruebas.",
    },
    {
        title: "Publicación y crecimiento",
        description:
            "Lanzamos la aplicación, analizamos su uso y agregamos mejoras según la evolución del proyecto.",
    },
];

const related = [
    {
        title: "Software a medida",
        description:
            "Construimos sistemas personalizados para gestionar operaciones internas y procesos empresariales.",
        href: "/soluciones/software-a-medida",
    },
    {
        title: "Automatización de procesos",
        description:
            "Conecta herramientas digitales y elimina tareas manuales dentro de tu negocio.",
        href: "/soluciones/automatizacion-de-procesos",
    },
    {
        title: "Ventas online",
        description:
            "Crea canales digitales para mostrar productos y recibir pedidos de clientes.",
        href: "/soluciones/ventas-por-internet",
    },
];

const faqs = [
    {
        question: "¿Qué tipo de aplicaciones móviles desarrollan?",
        answer: "Creamos aplicaciones para empresas, servicios, comercios, equipos internos, plataformas de clientes y soluciones personalizadas según cada necesidad.",
    },
    {
        question: "¿La aplicación funciona para Android y iPhone?",
        answer: "Sí. Analizamos el proyecto para definir la mejor estrategia de desarrollo considerando usuarios, presupuesto y objetivos del negocio.",
    },
    {
        question: "¿Cuánto demora crear una aplicación móvil?",
        answer: "El tiempo depende de la complejidad y funcionalidades necesarias. Recomendamos comenzar con una primera versión funcional para validar antes de ampliar el proyecto.",
    },
    {
        question: "¿Pueden conectar la app con mi sistema actual?",
        answer: "Sí. Podemos integrar la aplicación con sistemas existentes mediante APIs, bases de datos u otras soluciones tecnológicas.",
    },
    {
        question: "¿También ayudan a publicar la aplicación?",
        answer: "Sí. Acompañamos la configuración y publicación en Google Play y App Store para dejar la aplicación lista para los usuarios.",
    },
];
---

<SolutionPage
    eyebrow="Solución · Desarrollo de aplicaciones móviles"
    title="Creamos aplicaciones móviles para"
    highlight="conectar tu negocio."
    description="Diseñamos y desarrollamos aplicaciones Android e iOS personalizadas para empresas que necesitan mejorar la experiencia de sus clientes, digitalizar procesos o crear nuevos canales de servicio."
    metaTitle="Desarrollo de aplicaciones móviles en Perú | Apps Android e iOS | Velyon"
    metaDescription="Desarrollo de aplicaciones móviles personalizadas en Perú para empresas y negocios. Creamos apps Android e iOS, aplicaciones empresariales e integraciones digitales."
    path="/soluciones/aplicaciones-moviles"
    lottieSrc="/animations/apps-moviles.lottie"
    introTitle="Una aplicación debe resolver una necesidad real."
    intro="Antes de desarrollar una app analizamos el problema, los usuarios y el objetivo del negocio. Creamos soluciones móviles enfocadas en utilidad, facilidad de uso y crecimiento futuro."
    outcomes={outcomes}
    capabilities={capabilities}
    deliverables={[
        "Análisis funcional de la aplicación",
        "Diseño UX/UI móvil",
        "Desarrollo Android e iOS",
        "Integración con APIs",
        "Sistema de usuarios",
        "Notificaciones push",
        "Panel administrativo",
        "Publicación en tiendas",
        "Documentación técnica",
    ]}
    steps={steps}
    related={related}
    faqs={faqs}
/>
