---
import SolutionPage from "@/components/SolutionPage.astro";

const outcomes = [
    {
        title: "Alcance directo al bolsillo del usuario",
        description:
            "Presencia constante en el dispositivo principal de tus clientes con notificaciones y acceso inmediato.",
    },
    {
        title: "Experiencia nativa y fluida",
        description:
            "Aprovechamiento total del hardware del celular (cámara, GPS, notificaciones push, modo offline) con un rendimiento superior.",
    },
    {
        title: "Operación en campo conectada",
        description:
            "Permite a tu equipo registrar datos, estados o entregas en tiempo real desde cualquier lugar sin depender de una PC.",
    },
    {
        title: "Evolución por fases",
        description:
            "Lanzamos una primera versión con el núcleo funcional indispensable y escalamos de acuerdo con el uso real.",
    },
];

const capabilities = [
    {
        title: "Desarrollo iOS y Android",
        description:
            "Aplicaciones nativas e híbridas optimizadas para ofrecer una experiencia de usuario impecable.",
    },
    {
        title: "Sincronización en tiempo real",
        description:
            "Conexión directa con tu base de datos central y sistemas existentes mediante APIs seguras.",
    },
    {
        title: "Notificaciones push",
        description:
            "Alertas personalizadas para mantener enganchados a tus usuarios o coordinar a tu equipo en campo.",
    },
    {
        title: "Modo offline",
        description:
            "Capacidad de seguir operando y registrando información incluso cuando no hay conexión a internet.",
    },
    {
        title: "Paneles de administración",
        description:
            "Web de control para gestionar contenidos, usuarios, analíticas y configuraciones de la app.",
    },
    {
        title: "Publicación en stores",
        description:
            "Gestión completa para el despliegue y aprobación en Apple App Store y Google Play Store.",
    },
];

const steps = [
    {
        title: "Estrategia y alcance",
        description:
            "Definimos si necesitas una app nativa, el flujo principal de usuario y los requerimientos técnicos clave.",
    },
    {
        title: "Diseño y desarrollo MVP",
        description:
            "Diseñamos las interfaces (UI/UX) y construimos la primera versión funcional lista para pruebas y despliegue.",
    },
    {
        title: "Lanzamiento y evolución",
        description:
            "Publicamos en tiendas, monitoreamos el rendimiento y agregamos nuevas capacidades según tus objetivos.",
    },
];

const related = [
    {
        title: "Software a medida",
        description:
            "Paneles web, sistemas de gestión y plataformas robustas para la operación interna de tu negocio.",
        href: "/soluciones/software-a-medida",
    },
    {
        title: "Automatización de procesos",
        description:
            "Conecta formularios, WhatsApp y APIs para eliminar pasos manuales en tu negocio.",
        href: "/soluciones/automatizacion-de-procesos",
    },
    {
        title: "Soluciones para pymes y servicios",
        description:
            "Descubre cómo digitalizamos negocios de servicios y comercios.",
        href: "/sectores/pymes-y-servicios",
    },
];

const faqs = [
    {
        question: "¿Conviene desarrollar una app nativa o una web app?",
        answer: "Depende de tu presupuesto y objetivos. Si necesitas uso intensivo del hardware del celular (GPS, cámara, notificaciones avanzadas o modo offline completo), una app móvil es ideal. Si buscas algo más rápido para empezar, una plataforma web responsiva puede ser el punto de partida.",
    },
    {
        question: "¿Cuánto demora el desarrollo de una aplicación móvil?",
        answer: "Varía según la complejidad, pero una primera versión funcional (MVP) suele tomar entre 8 y 12 semanas de trabajo estructurado por etapas.",
    },
    {
        question: "¿Ayudan con la subida a Google Play y App Store?",
        answer: "Sí. Nos encargamos de todo el proceso técnico de configuración, revisión y publicación en ambas tiendas de aplicaciones.",
    },
    {
        question: "¿La aplicación se conecta con mi sistema actual?",
        answer: "Sí, diseñamos o adaptamos APIs seguras para que tu aplicación móvil comparta información en tiempo real con tus bases de datos o paneles existentes.",
    },
];
---

<SolutionPage
    eyebrow="Solución · Aplicaciones móviles"
    title="Aplicaciones móviles que extienden tu negocio al"
    highlight="celular de tus clientes."
    description="Diseñamos y desarrollamos aplicaciones móviles nativas y optimizadas para iOS y Android. Conecta con tus usuarios, automatiza la operación en campo y potencia tu alcance."
    metaTitle="Desarrollo de aplicaciones móviles en Perú | Velyon"
    metaDescription="Desarrollo de aplicaciones móviles personalizadas para iOS y Android en Perú. Apps empresariales, de servicios, e-commerce y más. Implementación por etapas."
    path="/soluciones/aplicaciones-moviles"
    lottieSrc="/animations/apps-moviles.lottie"
    introTitle="Una app debe resolver un problema real, no solo ocupar espacio."
    intro="Analizamos el contexto de tus usuarios antes de programar una sola línea de código. Evitamos complejidades innecesarias y enfocamos el desarrollo en la utilidad directa, el rendimiento y la facilidad de uso."
    outcomes={outcomes}
    capabilities={capabilities}
    deliverables={[
        "Desarrollo iOS y Android",
        "Diseño UI/UX adaptable",
        "Sincronización vía API",
        "Notificaciones push",
        "Modo offline básico",
        "Panel de control web",
        "Guías y despliegue en stores",
        "Documentación técnica",
    ]}
    steps={steps}
    related={related}
    faqs={faqs}
/>
