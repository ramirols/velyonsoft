---
import SolutionPage from "@/components/SolutionPage.astro";

const outcomes = [
    {
        title: "Menos tiempo en tareas manuales",
        description:
            "Automatizamos procesos repetitivos para que tu equipo pueda enfocarse en actividades que generan más valor para el negocio.",
    },
    {
        title: "Procesos más rápidos y ordenados",
        description:
            "Conectamos herramientas y eliminamos pasos innecesarios para mejorar la velocidad de operación.",
    },
    {
        title: "Menos errores por trabajo manual",
        description:
            "Reducimos problemas causados por copiar información, registrar datos varias veces o depender de procesos manuales.",
    },
    {
        title: "Tus sistemas trabajando juntos",
        description:
            "Integramos páginas web, formularios, WhatsApp, CRM, bases de datos y otras plataformas en un mismo flujo.",
    },
];

const capabilities = [
    {
        title: "Automatización de tareas repetitivas",
        description:
            "Digitalizamos procesos frecuentes como registros, notificaciones, seguimiento de clientes y actualización de información.",
    },
    {
        title: "Integración de sistemas",
        description:
            "Conectamos diferentes herramientas para que compartan información automáticamente y trabajen como un solo ecosistema.",
    },
    {
        title: "Automatización con WhatsApp y correo",
        description:
            "Creamos respuestas, avisos y seguimientos automáticos para clientes y equipos internos.",
    },
    {
        title: "Flujos comerciales automáticos",
        description:
            "Automatizamos procesos de captación, seguimiento de oportunidades y gestión de clientes.",
    },
    {
        title: "Sincronización de información",
        description:
            "Mantenemos actualizados tus datos entre plataformas evitando duplicidad y pérdida de información.",
    },
    {
        title: "Automatización con inteligencia artificial",
        description:
            "Aplicamos IA para clasificación de información, análisis de mensajes y asistencia en procesos internos.",
    },
];

const steps = [
    {
        title: "Analizamos tu proceso actual",
        description:
            "Identificamos tareas repetitivas, puntos de demora, herramientas utilizadas y oportunidades de mejora.",
    },
    {
        title: "Diseñamos la automatización",
        description:
            "Definimos reglas, conexiones y flujos para que las herramientas trabajen automáticamente.",
    },
    {
        title: "Implementamos y optimizamos",
        description:
            "Probamos los escenarios reales, monitoreamos resultados y ajustamos el sistema para mejorar continuamente.",
    },
];

const related = [
    {
        title: "Software a medida",
        description:
            "Construye plataformas personalizadas para administrar procesos internos y operaciones.",
        href: "/soluciones/software-a-medida",
    },
    {
        title: "Mantenimiento y evolución",
        description:
            "Mantén tus sistemas seguros, actualizados y preparados para crecer.",
        href: "/soluciones/mantenimiento-y-evolucion",
    },
    {
        title: "Tiendas online y ventas digitales",
        description:
            "Conecta ventas, pedidos, clientes y herramientas comerciales.",
        href: "/soluciones/ventas-por-internet",
    },
];

const faqs = [
    {
        question: "¿Qué procesos se pueden automatizar en una empresa?",
        answer: "Se pueden automatizar tareas como envío de mensajes, registro de clientes, seguimiento comercial, generación de reportes, actualización de datos y conexión entre diferentes plataformas.",
    },
    {
        question: "¿Necesito cambiar mis sistemas actuales para automatizar?",
        answer: "No necesariamente. Primero evaluamos las herramientas que ya utilizas y buscamos integrarlas antes de reemplazarlas.",
    },
    {
        question: "¿La automatización funciona para pequeñas empresas?",
        answer: "Sí. Las pequeñas empresas también pueden beneficiarse automatizando tareas administrativas, ventas, atención al cliente y procesos repetitivos.",
    },
    {
        question: "¿Puedo incorporar inteligencia artificial en mis procesos?",
        answer: "Sí. Evaluamos dónde la inteligencia artificial puede aportar valor, por ejemplo en análisis de información, clasificación de consultas o asistencia interna.",
    },
];
---

<SolutionPage
    eyebrow="Solución · Automatización empresarial"
    title="Automatiza procesos de tu negocio y"
    highlight="ahorra tiempo operativo."
    description="Diseñamos automatizaciones que conectan tus herramientas, eliminan tareas repetitivas y permiten que tu equipo trabaje de forma más rápida y eficiente."
    metaTitle="Automatización de procesos empresariales en Perú | Velyon"
    metaDescription="Automatización de procesos para empresas en Perú. Integramos sistemas, WhatsApp, correos, APIs e inteligencia artificial para ahorrar tiempo y reducir tareas manuales."
    path="/soluciones/automatizacion-de-procesos"
    lottieSrc="/animations/automatizacion.lottie"
    introTitle="Tu equipo debería crear valor, no repetir tareas."
    intro="Analizamos las actividades repetitivas de tu negocio para diseñar flujos automáticos que reduzcan trabajo manual, conecten herramientas digitales y mejoren la eficiencia operativa."
    outcomes={outcomes}
    capabilities={capabilities}
    deliverables={[
        "Análisis de procesos actuales",
        "Diseño de flujos automatizados",
        "Integración entre plataformas",
        "Automatización de WhatsApp y correo",
        "Conexión mediante APIs",
        "Sincronización de datos",
        "Automatización con IA",
        "Monitoreo y documentación",
    ]}
    steps={steps}
    related={related}
    faqs={faqs}
/>
