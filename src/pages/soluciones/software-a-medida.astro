---
import SolutionPage from "@/components/SolutionPage.astro";

const outcomes = [
  {
    title: "Sistemas adaptados a tus procesos, no al revés",
    description:
      "A diferencia del software comercial enlatado que te obliga a cambiar cómo operas o te cobra licencias mensuales por cada empleado, desarrollamos plataformas web diseñadas exactamente sobre la lógica, reglas y flujos de tu empresa.",
  },
  {
    title: "Eliminación de hojas de cálculo dispersas y datos duplicados",
    description:
      "Centraliza pedidos, clientes, inventarios, documentos y estados operativos en una sola base de datos segura en la nube. Todo tu equipo accede a información actualizada en tiempo real sin versiones contradictorias en Excel.",
  },
  {
    title: "Paneles de control con métricas e indicadores en vivo",
    description:
      "Visualiza el rendimiento de tu negocio al instante: ventas del mes, cotizaciones pendientes, stock disponible o tiempos de entrega. Toma decisiones estratégicas basadas en datos concretos y no en suposiciones.",
  },
  {
    title: "Desarrollo por fases con presupuesto cerrado",
    description:
      "No necesitas invertir en un megaproyecto de meses para ver resultados. Comenzamos con un MVP (versión funcional inicial) que resuelve los cuellos de botella más urgentes y ampliamos módulos según el retorno de inversión y la adopción de tu equipo.",
  },
];

const capabilities = [
  {
    title: "Sistemas web de gestión empresarial (ERP y CRM a medida)",
    description:
      "Plataformas para gestionar cotizaciones, clientes, seguimiento de prospectos comerciales, órdenes de servicio y facturación interna desde un solo lugar.",
  },
  {
    title: "Paneles administrativos y control operativo",
    description:
      "Interfaces privadas con control de accesos, roles y permisos específicos para administradores, supervisores y personal de campo.",
  },
  {
    title: "Portales privados para clientes y proveedores",
    description:
      "Espacios protegidos con usuario y contraseña donde tus clientes pueden consultar el estado de sus pedidos, descargar comprobantes o enviar solicitudes de servicio.",
  },
  {
    title: "Control de almacenes, stock y trazabilidad de productos",
    description:
      "Módulos para registrar entradas, salidas, transferencias entre sucursales, alertas de stock mínimo y reportes históricos de movimientos.",
  },
  {
    title: "Integración con APIs, pasarelas de pago y facturación",
    description:
      "Conexión de tu software con sistemas de facturación electrónica (SUNAT en Perú y proveedores en LATAM), pasarelas bancarias y servicios en la nube.",
  },
  {
    title: "Desarrollo de MVP para nuevos modelos de negocio digital",
    description:
      "Construcción ágil de plataformas SaaS o prototipos funcionales para emprendedores y empresas que desean validar un producto digital con usuarios reales.",
  },
];

const steps = [
  {
    title: "Levantamiento de procesos y requerimientos",
    description:
      "Mapeamos cómo opera tu negocio hoy, los cuellos de botella existentes y definimos la arquitectura del sistema con entregables y presupuesto cerrado.",
  },
  {
    title: "Diseño de interfaces y desarrollo ágil",
    description:
      "Construimos el sistema en iteraciones funcionales para que puedas probar los módulos clave antes del lanzamiento definitivo.",
  },
  {
    title: "Capacitación, migración de datos y puesta en marcha",
    description:
      "Cargamos la información inicial, capacitamos a tu equipo de trabajo y dejamos la plataforma operando en tu propio servidor en la nube.",
  },
];

const related = [
  {
    title: "Automatización de procesos",
    description:
      "Conecta tu software interno con WhatsApp, correos y flujos automáticos para ahorrar tiempo operativo.",
    href: "/soluciones/automatizacion-de-procesos",
  },
  {
    title: "Aplicaciones móviles Android e iOS",
    description:
      "Lleva los módulos de tu sistema al celular de tu equipo de campo o clientes para operar sin cables.",
    href: "/soluciones/aplicaciones-moviles",
  },
  {
    title: "Mantenimiento y soporte evolutivo",
    description:
      "Monitoreo técnico continuo, seguridad, respaldos y desarrollo de nuevos módulos para tus sistemas.",
    href: "/soluciones/mantenimiento-y-evolucion",
  },
];

const faqs = [
  {
    question: "¿Cuándo le conviene a una empresa invertir en software a medida?",
    answer:
      "Conviene cuando las herramientas comerciales existentes no se ajustan a tu flujo de trabajo, cuando cobran costos excesivos de licencias mensuales por cada usuario adicional, o cuando tus operaciones dependen de hojas de cálculo complejas y propensas a errores que consumen horas de trabajo manual.",
  },
  {
    question: "¿Es necesario pagar licencias mensuales o el software me pertenece?",
    answer:
      "El software desarrollado por VelyonSoft es de tu exclusiva propiedad. Te entregamos el código fuente completo y la infraestructura queda a nombre de tu empresa. Solo pagas por los servidores en la nube que utilices (como AWS, Vercel o Supabase) a precio de costo directo, sin intermediarios.",
  },
  {
    question: "¿Pueden migrar la información que actualmente tenemos en Excel?",
    answer:
      "Sí. Durante la fase de puesta en marcha limpiamos y estructuramos las bases de datos de clientes, productos o historial operativo de tus hojas de cálculo para importarlas directamente al nuevo sistema sin pérdidas de información.",
  },
  {
    question: "¿Cómo se define el presupuesto de un software a medida?",
    answer:
      "El presupuesto se establece a precio cerrado antes de iniciar. Evaluamos la cantidad de módulos necesarios (por ejemplo: clientes, inventario, reportes), el nivel de integraciones externas (APIs, facturación) y los tipos de usuarios con diferentes permisos.",
  },
  {
    question: "¿Qué garantía y soporte ofrecen tras la entrega del sistema?",
    answer:
      "Todos los proyectos incluyen un periodo de garantía técnica post-lanzamiento para corregir cualquier incidencia sin costo. Adicionalmente, ofrecemos planes mensuales de mantenimiento evolutivo para agregar nuevas funcionalidades a medida que tu negocio crezca.",
  },
];
---

<SolutionPage
  eyebrow="Solución · Desarrollo de software a medida"
  title="Software personalizado para centralizar y optimizar los procesos de"
  highlight="tu empresa."
  description="Desarrollamos sistemas web a medida, paneles administrativos y plataformas empresariales para negocios en Perú y Latinoamérica. Elimina el desorden de hojas de cálculo, automatiza operaciones y mantén el control total de tu información sin pagar licencias por usuario."
  metaTitle="Desarrollo de Software a Medida y Sistemas Web en Perú y LATAM | VelyonSoft"
  metaDescription="Desarrollamos software a medida y sistemas web para empresas en Perú y Latinoamérica. Paneles de administración, portales de clientes y automatización sin licencias recurrentes."
  path="/soluciones/software-a-medida"
  lottieSrc="/animations/software-a-medida.lottie"
  introTitle="El software estándar te limita; el software a medida te da ventaja competitiva."
  intro="Comprar licencias de software comercial genérico suele significar pagar por funciones que nunca usas y adaptar tus métodos de trabajo a lo que el programa impone. En VelyonSoft analizamos tu operación real y construimos una herramienta exclusiva para tu negocio: rápida, intuitiva para tu equipo y con el alcance exacto que necesitas."
  outcomes={outcomes}
  capabilities={capabilities}
  deliverables={[
    "Documento de alcance técnico y arquitectura",
    "Diseño de interfaz administrativa UX/UI",
    "Base de datos relacional segura en la nube",
    "Módulos operativos y paneles de control",
    "Gestión de roles y permisos por usuario",
    "Migración de datos iniciales desde Excel",
    "Integración con APIs o facturación",
    "Garantía técnica y código fuente completo",
    "Manual de usuario y sesiones de capacitación",
  ]}
  steps={steps}
  related={related}
  faqs={faqs}
/>