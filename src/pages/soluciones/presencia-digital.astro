---
import DetailPage from "@/components/DetailPage.astro";
import { siteConfig } from "@/lib/site";

const benefits = [
  {
    title: "Confianza desde el primer clic",
    description:
      "Una imagen profesional y mensajes claros para que las personas entiendan por qué elegirte.",
  },
  {
    title: "Más consultas calificadas",
    description:
      "Rutas de conversión, llamadas a la acción y contacto directo por WhatsApp o formulario.",
  },
  {
    title: "Base preparada para posicionar",
    description:
      "Estructura semántica, rendimiento y SEO técnico listos para crecer con contenido.",
  },
  {
    title: "Fácil de mantener",
    description:
      "Componentes reutilizables y una arquitectura que permite ampliar la web sin rehacerla.",
  },
];
const steps = [
  {
    title: "Diagnóstico y contenido",
    description:
      "Definimos público, objetivo, propuesta de valor y páginas necesarias.",
  },
  {
    title: "Diseño y desarrollo",
    description:
      "Creamos una experiencia responsive alineada con la identidad del negocio.",
  },
  {
    title: "Publicación y mejora",
    description:
      "Medimos, corregimos y acompañamos el crecimiento mediante un plan mensual opcional.",
  },
];

const faqs = [
  {
    question: "¿Cuánto cuesta una página web para un negocio en Perú?",
    answer:
      "El precio depende de la cantidad de páginas, funciones, contenido e integraciones necesarias. Una landing tiene un alcance diferente a una web corporativa, catálogo digital o tienda virtual. Después del diagnóstico entregamos una propuesta con alcance, plazo y precio definidos.",
  },
  {
    question: "¿Una landing o una web con varias páginas?",
    answer:
      "Depende del objetivo. Una campaña o servicio concreto puede funcionar con una landing. Una empresa con varios servicios suele necesitar páginas internas para explicar y posicionar cada solución en Google.",
  },
  {
    question: "¿La página estará optimizada para Google?",
    answer:
      "Sí. Trabajamos la estructura semántica, títulos, descripciones, URLs, velocidad, sitemap, datos estructurados y experiencia móvil. El crecimiento posterior depende también del contenido, la competencia y la autoridad del dominio.",
  },
  {
    question: "¿Incluye dominio y hosting?",
    answer:
      "Podemos configurar y administrar ambos servicios. El dominio debe quedar registrado a nombre del cliente para asegurar que conserve su propiedad.",
  },
  {
    question: "¿Podré editar los textos y las imágenes?",
    answer:
      "Sí. Según las características del proyecto, podemos integrar un gestor de contenido o dejar componentes editables con documentación clara.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.url}/soluciones/presencia-digital#service`,
  name: "Diseño de páginas web para negocios",
  serviceType: "Diseño y desarrollo de páginas web",
  description:
    "Diseño y desarrollo de páginas web corporativas, landing pages y catálogos digitales para negocios y empresas en Perú.",
  url: `${siteConfig.url}/soluciones/presencia-digital`,
  provider: {
    "@id": `${siteConfig.url}/#organization`,
  },
  areaServed: {
    "@type": "Country",
    name: "Perú",
  },
};
---

<DetailPage
  schema={serviceSchema}
  eyebrow="Solución · Presencia digital"
  title="Una web que convierte tu experiencia en"
  highlight="confianza y clientes"
  description="Diseñamos páginas web corporativas, landings y catálogos digitales para negocios y empresas en Perú que necesitan atraer clientes y presentar sus servicios profesionalmente."
  metaTitle="Páginas web para negocios en Perú | Velyon"
  metaDescription="Diseño y desarrollo de páginas web para negocios y empresas en Perú. Webs rápidas, responsive, optimizadas para Google y preparadas para generar consultas."
  path="/soluciones/presencia-digital"
  lottieSrc="/animations/presencia-digital.lottie"
  introTitle="Tu web debe explicar, convencer y facilitar el siguiente paso."
  intro="Una página web profesional debe explicar qué hace tu negocio, generar confianza y facilitar que los visitantes soliciten información. En Velyon analizamos a tu público, tus servicios y tus objetivos antes de diseñar una solución digital preparada para posicionarse y convertir visitas en oportunidades."
  {benefits}
  deliverables={[
    "Arquitectura y estrategia de contenidos",
    "Diseño responsive para celulares y computadoras",
    "Desarrollo web rápido y escalable en Astro",
    "Integración con WhatsApp y formularios",
    "SEO técnico inicial",
    "Configuración de analítica y medición",
    "Optimización de velocidad",
    "Capacitación y soporte",
  ]}
  {steps}
  {faqs}
/>
