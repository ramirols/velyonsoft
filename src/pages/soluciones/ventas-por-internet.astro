  capabilities={capabilities}
  deliverables={[
    "Arquitectura ecommerce",
    "Diseño UX/UI",
    "Catálogo de productos",
    "Carrito de compra",
    "Pedidos online",
    "Integración WhatsApp",
    "Pasarelas de pago",
    "Configuración analítica",
    "Optimización inicial SEO",
