---
import SolutionPage from "@/components/SolutionPage.astro";

const outcomes = [
  {
    title: "Una imagen corporativa que transmite autoridad inmediata",
    description:
      "Cuando un cliente potencial busca tu empresa en Google, tu web es su primera impresión. Diseñamos sitios limpios, modernos y estructurados que comunican qué haces, a quién ayudas y por qué deberían contratarte a ti.",
  },
  {
    title: "Estructura orientada a generar oportunidades de contacto",
    description:
      "Una web bonita no sirve si nadie te escribe. Diseñamos recorridos claros con llamados a la acción estratégicos hacia WhatsApp, formularios directos y llamadas, facilitando que una visita interesada se convierta en una conversación de venta.",
  },
  {
    title: "Arquitectura técnica optimizada para Google (SEO técnico)",
    description:
      "Construimos tu sitio web con código limpio y ligero, metadatos semánticos, marcado estructurado JSON-LD, sitemap XML y tiempos de carga instantáneos para cumplir con los estándares de Core Web Vitals de Google.",
  },
  {
    title: "Propiedad total y escalabilidad sin ataduras",
    description:
      "El dominio, los servidores en la nube y el código fuente quedan a tu nombre desde el primer día. No usamos plantillas saturadas ni plugins vulnerables. Puedes ampliar secciones, servicios o integrar nuevas herramientas cuando tu negocio lo necesite.",
  },
];

const capabilities = [
  {
    title: "Páginas web corporativas e institucionales",
    description:
      "Sitios completos para empresas medianas, pymes y firmas que necesitan presentar servicios, equipo, trayectoria, certificaciones y casos de éxito con máxima solidez.",
  },
  {
    title: "Landing pages de alta conversión comercial",
    description:
      "Páginas de aterrizaje de sección única o embudos específicos diseñados para captar prospectos calificados desde campañas de Google Ads, Meta Ads o tráfico orgánico.",
  },
  {
    title: "Catálogos institucionales y portafolios de servicios",
    description:
      "Módulos para exponer líneas de servicio, productos industriales, proyectos concluidos o fichas técnicas sin requerir una tienda con pasarela bancaria.",
  },
  {
    title: "Integración con WhatsApp y canales de atención",
    description:
      "Botones flotantes contextualizados, enlaces de consulta por servicio y formularios que envían notificaciones inmediatas a tu correo o equipo comercial.",
  },
  {
    title: "Optimización de velocidad de carga y mobile-first",
    description:
      "Diseño adaptable al 100% para celulares y computadoras, con compresión de imágenes de última generación (WebP/AVIF) y tiempos de carga menores a 2 segundos.",
  },
  {
    title: "Configuración analítica y seguimiento de eventos",
    description:
      "Instalación de Google Analytics 4, Google Tag Manager y píxeles de conversión para medir cuántas personas visitan tu web y cuántas hacen clic para contactarte.",
  },
];

const steps = [
  {
    title: "Estrategia, arquitectura y contenido",
    description:
      "Analizamos tu propuesta comercial, tus clientes objetivo y tus competidores para definir la estructura de páginas, textos persuasivos y puntos de contacto.",
  },
  {
    title: "Diseño UX/UI y desarrollo a medida",
    description:
      "Construimos el sitio con tecnologías web modernas, diseño visual exclusivo adaptado a tu identidad de marca y optimización de rendimiento.",
  },
  {
    title: "Pruebas técnicas, publicación y entrega",
    description:
      "Revisamos compatibilidad móvil, indexación inicial en Google Search Console y te entregamos los accesos completos con capacitación de uso.",
  },
];

const related = [
  {
    title: "Tiendas online y catálogos digitales",
    description:
      "Convierte tu catálogo de productos en un canal de pedidos ordenado por WhatsApp o pasarelas de pago.",
    href: "/soluciones/ventas-por-internet",
  },
  {
    title: "Software a medida y sistemas web",
    description:
      "Sistemas personalizados para administrar clientes, operaciones y procesos internos de tu empresa.",
    href: "/soluciones/software-a-medida",
  },
  {
    title: "Mantenimiento web y soporte continuo",
    description:
      "Soporte técnico, actualizaciones de seguridad y evolución continua para mantener tu web siempre operativa.",
    href: "/soluciones/mantenimiento-y-evolucion",
  },
];

const faqs = [
  {
    question: "¿Cuánto cuesta desarrollar una página web profesional para una empresa?",
    answer:
      "El costo depende del alcance específico del proyecto: una landing page comercial enfocada en un solo servicio tiene una inversión menor a un sitio web corporativo de 5 a 10 secciones con catálogo o integraciones personalizadas. En VelyonSoft trabajamos con presupuesto cerrado y alcance definido por escrito antes de iniciar.",
  },
  {
    question: "¿En qué se diferencia el desarrollo de VelyonSoft frente a una plantilla común?",
    answer:
      "Muchos proveedores instalan plantillas prefabricadas en WordPress con decenas de plugins pesados que ralentizan la carga y sufren hackeos frecuentes. En VelyonSoft desarrollamos con código moderno y ligero (Astro y Tailwind CSS), garantizando una carga casi instantánea en celulares, alta seguridad y un diseño pensado en tu cliente.",
  },
  {
    question: "¿La página web aparecerá en los resultados de Google?",
    answer:
      "Sí. Aplicamos las mejores prácticas de SEO técnico: etiquetas de título y meta descripciones únicas, jerarquía H1-H3 correcta, marcado Schema.org, sitemap XML, robots.txt optimizado y velocidad certificada para facilitar que Google rastree e indexe tus páginas.",
  },
  {
    question: "¿Quién es el dueño del dominio, hosting y código de la web?",
    answer:
      "Tú eres el único dueño. El dominio se registra a tu nombre y te entregamos el repositorio con el código fuente completo. No cobramos mensualidades de mantenimiento forzosas ni retenemos tu información.",
  },
  {
    question: "¿Cuánto tiempo toma el desarrollo y lanzamiento de una página web?",
    answer:
      "Una landing page comercial suele estar lista en 7 a 10 días laborables, mientras que un sitio web corporativo completo suele completarse en 2 a 3 semanas, dependiendo de la rapidez con la que se disponga de la información y fotografías de la empresa.",
  },
  {
    question: "¿Atienden proyectos fuera de Lima o en otros países de Latinoamérica?",
    answer:
      "Sí. Nuestra sede está en Lima, Perú, pero trabajamos de forma 100% remota y colaborativa con empresas de todo el país y de Latinoamérica mediante reuniones por videollamada y canales directos en WhatsApp.",
  },
];
---

<SolutionPage
  eyebrow="Solución · Diseño y desarrollo web profesional"
  title="Páginas web profesionales diseñadas para convertir visitas en"
  highlight="clientes reales."
  description="Desarrollamos sitios web corporativos y landing pages a medida para empresas y profesionales en Perú y Latinoamérica. Webs ultrarrápidas, adaptadas a celulares, con SEO técnico y preparadas para captar prospectos comerciales."
  metaTitle="Desarrollo de Páginas Web Profesionales en Perú y LATAM | VelyonSoft"
  metaDescription="Diseño y desarrollo de páginas web profesionales para empresas en Perú y Latinoamérica. Sitios rápidos, responsive, con SEO técnico y enfocados en captar clientes reales."
  path="/soluciones/desarrollo-web"
  lottieSrc="/animations/desarrollo-web.lottie"
  introTitle="Tu web corporativa debe explicar, convencer y generar oportunidades de negocio."
  intro="Una página web no es un folleto digital pasivo: es tu principal carta de presentación comercial las 24 horas. Si tu sitio tarda en cargar, se ve desordenado en el celular o no explica con claridad por qué tu solución es la mejor, los clientes potenciales simplemente se van con tu competencia. Diseñamos sitios web pensados para generar credibilidad y facilitar el contacto comercial."
  outcomes={outcomes}
  capabilities={capabilities}
  deliverables={[
    "Estrategia de arquitectura y navegación",
    "Diseño visual UX/UI personalizado",
    "Desarrollo responsive mobile-first",
    "Integración directa con WhatsApp",
    "Formularios de contacto seguros",
    "Optimización de velocidad y Core Web Vitals",
    "Configuración técnica SEO y Schema.org",
    "Conexión con Google Analytics 4",
    "Propiedad total del código y accesos",
  ]}
  steps={steps}
  related={related}
  faqs={faqs}
/>
