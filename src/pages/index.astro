---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import ProblemSelector from "@/components/sections/ProblemSelector.astro";
import Solutions from "@/components/sections/Solutions.astro";
import ProductSpotlight from "@/components/sections/ProductSpotlight.astro";
import ProjectsShowcase from "@/components/sections/ProjectsShowcase.astro";
import Sectors from "@/components/sections/Sectors.astro";
import Process from "@/components/sections/Process.astro";
import Plans from "@/components/sections/Plans.astro";
import Faq from "@/components/sections/Faq.astro";
import Contact from "@/components/sections/Contact.astro";
---

<BaseLayout
  title="Velyon | Software, páginas web y automatización en Perú"
  description="Creamos páginas web, tiendas online, sistemas a medida y automatizaciones para negocios y empresas en Perú."
>
  <main transition:animate="slide">
    <Hero />
    <ProblemSelector />
    <Solutions />
    <ProductSpotlight />
    <ProjectsShowcase />
    <Sectors />
    <Process />
    <Plans />
    <Faq />
    <Contact />
  </main>
</BaseLayout>
