---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Ventas y cotizaciones perdidas en chats de WhatsApp",
    description:
      "Muchos negocios gestionan consultas comerciales entre varios celulares o conversaciones personales, lo que provoca demoras en cotizar, prospectos olvidados y ventas que se van con la competencia.",
  },
  {
    title: "Tareas manuales que saturan al dueño y al equipo",
    description:
      "El personal invierte horas pasando datos a mano, revisando transferencias bancarias, actualizando listas de precios en Excel y respondiendo una y otra vez las mismas dudas básicas de clientes.",
  },
  {
    title: "Falta de control centralizado sobre el negocio",
    description:
      "A medida que la pyme crece, el dueño no tiene visibilidad clara de cuánto se vendió en la semana, qué pedidos faltan despachar o cuánto stock real queda disponible en almacén.",
  },
  {
    title: "Presencia digital precaria o inexistente",
    description:
      "Depender únicamente de una página de Facebook o Instagram genera desconfianza en compras de mayor valor y limita el alcance frente a empresas con páginas web profesionales.",
  },
];

const solutions = [
  {
    title: "Desarrollo web profesional para pymes",
    description:
      "Sitios web modernos que posicionan a tu empresa en Google, transmiten confianza comercial y generan consultas directas a tu equipo de ventas.",
    href: "/soluciones/desarrollo-web",
    label: "Captación de clientes",
  },
  {
    title: "Catálogos digitales y tiendas online",
    description:
      "Exhibe tus productos organizados por categorías con precios actualizados y pedidos desglosados directamente a WhatsApp.",
    href: "/soluciones/ventas-por-internet",
    label: "Ventas ordenadas",
  },
  {
    title: "Sistemas de gestión operativa y CRM a medida",
    description:
      "Paneles sencillos para controlar clientes, pedidos, cotizaciones, stock y cuentas por cobrar sin complicar a tu personal.",
    href: "/soluciones/software-a-medida",
    label: "Control diario",
  },
];

const principles = [
  {
    title: "Tecnología práctica, no burocracia digital",
    description:
      "Creamos herramientas intuitivas que cualquier empleado aprende a usar en 15 minutos, sin pantallas recargadas ni pasos innecesarios.",
  },
  {
    title: "Retorno de inversión antes que complejidad",
    description:
      "Comenzamos resolviendo el problema que más dinero o tiempo te hace perder hoy, ya sea ordenar pedidos o captar clientes en Google.",
  },
  {
    title: "Presupuesto cerrado sin sorpresas",
    description:
      "Sabes con exactitud cuánto vas a invertir y qué vas a recibir antes de iniciar, sin cobros mensuales ocultos por licenciamiento.",
  },
  {
    title: "Trato directo con el desarrollador",
    description:
      "Hablas directamente con la persona que programa tu solución técnica, garantizando agilidad y comprensión real de tu negocio.",
  },
];

const faqs = [
  {
    question: "¿Es necesario contratar un software costoso para digitalizar una pyme?",
    answer:
      "No. La mayoría de pymes fracasan al intentar implementar softwares gigantes y caros que nadie en el equipo sabe usar. Es mucho más efectivo construir herramientas a medida con los 2 o 3 módulos clave que tu negocio necesita (por ejemplo: catálogo web + pedidos WhatsApp + control de cobros).",
  },
  {
    question: "¿Pueden ayudar a un negocio que actualmente solo trabaja con Excel y libreta?",
    answer:
      "Por supuesto. La mayoría de nuestros clientes comenzaron con hojas de cálculo. Diseñamos la transición paso a paso para que tu equipo migre de forma natural y sin estrés operativo.",
  },
  {
    question: "¿Qué resultados comerciales puede esperar una pequeña empresa?",
    answer:
      "Una presencia web profesional permite aparecer en búsquedas comerciales de Google cuando clientes buscan tus productos o servicios, mientras que un catálogo ordenado reduce drásticamente el tiempo que tardas en atender y cerrar una venta.",
  },
  {
    question: "¿Cómo coordinamos si mi empresa está en provincia o fuera de Lima?",
    answer:
      "Trabajamos con empresas de todo el Perú y Latinoamérica de forma 100% remota mediante reuniones breves por Google Meet y coordinación fluida por WhatsApp y correo.",
  },
];
---

<SectorPage
  sector="Pymes y comercio"
  title="Tecnología práctica para que pequeñas y medianas empresas vendan y"
  highlight="crezcan con orden."
  description="Soluciones digitales y desarrollo a medida para pequeñas y medianas empresas en Perú y Latinoamérica. Páginas web comerciales, catálogos online y sistemas de gestión para captar clientes y ordenar tu operación diaria."
  metaTitle="Digitalización y Software Práctico para Pymes en Perú y LATAM | VelyonSoft"
  metaDescription="Desarrollo web, catálogos online, automatización y software a medida para pymes en Perú y Latinoamérica. Digitaliza ventas y operaciones sin sistemas complicados."
  path="/sectores/pymes-y-servicios"
  lottieSrc="/animations/negocios-y-servicios.lottie"
  audiences={[
    "Pequeñas y medianas empresas (Pymes)",
    "Negocios comerciales y distribuidores",
    "Empresas familiares en crecimiento",
    "Emprendimientos con equipo propio",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución práctica para pymes",
    title: "Sistemas web de gestión de pedidos y control de clientes.",
    description:
      "Paneles sencillos y personalizados para sustituir hojas de cálculo caóticas y centralizar ventas, cobranzas y tareas operativas.",
    href: "/soluciones/software-a-medida",
    status: "Desarrollo a medida",
    ctaText: "Ver sistemas a medida para pymes",
  }}
  {faqs}
/>