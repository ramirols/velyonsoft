---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Prospectos de compra que se enfrían por respuesta tardía",
    description:
      "Los compradores de inmuebles suelen consultar en varios proyectos a la vez. Si tu inmobiliaria tarda más de unas horas en responder con información clara, el cliente agenda visita con otra constructora.",
  },
  {
    title: "Información de proyectos dispersa en folletos pesados",
    description:
      "Enviar PDFs gigantes por WhatsApp con planos borrosos o listas de precios desactualizadas genera frustración en el comprador y retrasa la toma de decisiones.",
  },
  {
    title: "Dependencia de portales inmobiliarios de pago mensual",
    description:
      "Publicar únicamente en portales de clasificados significa competir directamente al lado de cientos de propiedades rivales, sin construir el posicionamiento de marca de tu propia constructora.",
  },
  {
    title: "Seguimiento comercial sin control ni métricas",
    description:
      "Sin un sistema centralizado, los asesores de ventas manejan sus propios prospectos de forma independiente, perdiendo trazabilidad cuando un asesor cambia de trabajo.",
  },
];

const solutions = [
  {
    title: "Portales y páginas web para proyectos inmobiliarios",
    description:
      "Sitios web enfocados en lanzamiento de edificios y condominios: tipologías de departamentos, áreas comunes, acabados, ubicación y formulario de cotización rápida.",
    href: "/soluciones/desarrollo-web",
    label: "Captación de prospectos",
  },
  {
    title: "Software a medida para gestión de inmuebles y prospectos",
    description:
      "Sistemas personalizados para registrar inventario de departamentos disponibles/separados/vendidos y controlar el embudo comercial de tus asesores.",
    href: "/soluciones/software-a-medida",
    label: "Control de ventas",
  },
  {
    title: "Automatización de leads desde pauta publicitaria",
    description:
      "Conexión instantánea de clientes que solicitan información en Facebook Ads o Google Ads directo al WhatsApp del asesor asignado.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Velocidad de contacto",
  },
];

const principles = [
  {
    title: "Experiencia visual que resalta el valor del inmueble",
    description:
      "Estructuramos galerías de renders, planos en alta resolución y recorridos virtuales para que el comprador visualize su futuro hogar o inversión.",
  },
  {
    title: "Filtros intuitivos por zona, precio y tipología",
    description:
      "Facilitamos que el visitante encuentre rápidamente departamentos de 1, 2 o 3 dormitorios dentro de su rango de presupuesto.",
  },
  {
    title: "Formularios de contacto rápidos y directos",
    description:
      "Reducimos la fricción al mínimo: campos esenciales para que el prospecto solicite cotización o agenda de visita al piloto en un solo paso.",
  },
  {
    title: "Propiedad total de la plataforma y de los leads",
    description:
      "La base de datos de compradores e inversionistas es un activo estratégico de tu empresa que debe residir en tu propia infraestructura.",
  },
];

const faqs = [
  {
    question: "¿Desarrollan páginas tanto para una constructora como para agencias de corretaje?",
    answer:
      "Sí. Diseñamos tanto landing pages de conversión para el lanzamiento de un proyecto inmobiliario específico (edificio residencial o lotes) como portales completos de búsqueda multizona para agencias de corretaje inmobiliario.",
  },
  {
    question: "¿Se pueden mostrar planos interactivos y tipologías de departamentos?",
    answer:
      "Sí. Creamos módulos donde el usuario puede alternar entre tipologías (por ejemplo: Tipo Flat 65m², Tipo Dúplex 110m²), visualizar la distribución del plano arquitectónico y descargar la ficha técnica en PDF.",
  },
  {
    question: "¿Cómo se integra la web con las campañas publicitarias de Meta y Google Ads?",
    answer:
      "Configuramos las etiquetas de seguimiento y píxeles de conversión en cada botón de cotización o WhatsApp, permitiendo que tus campañas de anuncios optimicen el costo por lead calificado.",
  },
  {
    question: "¿Pueden desarrollar un sistema para controlar el estado de unidades vendidas y separadas?",
    answer:
      "Sí. A través de nuestro servicio de software a medida podemos construir un panel interno donde la gerencia comercial visualiza en tiempo real qué unidades están libres, separadas con arras o vendidas.",
  },
];
---

<SectorPage
  sector="Inmobiliarias y constructoras"
  title="Portales web y herramientas de captación para"
  highlight="inmobiliarias y constructoras."
  description="Desarrollamos páginas web de proyectos inmobiliarios, portales de corretaje y sistemas de gestión de prospectos en Perú y Latinoamérica. Presenta tus edificios, departamentos o lotes con máxima calidad visual y acelera la venta de unidades."
  metaTitle="Páginas Web y Catálogos de Proyectos Inmobiliarios | VelyonSoft"
  metaDescription="Desarrollo de páginas web para inmobiliarias y constructoras en Perú y Latinoamérica. Portales de proyectos, filtros avanzados de búsqueda y captación de leads."
  path="/sectores/inmobiliarias"
  lottieSrc="/animations/inmobiliarias.lottie"
  audiences={[
    "Empresas constructoras y desarrolladoras",
    "Agencias de corretaje inmobiliario",
    "Promotoras de condominios y lotizaciones",
    "Agentes inmobiliarios independientes",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución inmobiliaria",
    title: "Catálogo interactivo de proyectos y captación de prospectos.",
    description:
      "Sitios web enfocados en proyectos residenciales o comerciales con planos, renders, cotizadores y conexión inmediata a WhatsApp.",
    href: "/soluciones/desarrollo-web",
    status: "Desarrollo inmobiliario",
    ctaText: "Ver desarrollo web inmobiliario",
  }}
  {faqs}
/>