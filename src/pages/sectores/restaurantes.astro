        description:
            "Comenzamos con necesidades prioritarias y ampliamos según resultados.",
    },
];

const faqs = [
    {
        question: "¿Desarrollan páginas web para restaurantes?",
        answer: "Sí. Creamos páginas web gastronómicas con información del negocio, carta digital, ubicación, reservas y canales de contacto.",
    },
    {
        question: "¿Pueden crear sistemas de pedidos online?",
        answer: "Sí. Podemos desarrollar catálogos digitales y soluciones de pedidos adaptadas al modelo de atención del restaurante.",
    },
    {
        question: "¿La solución reemplaza plataformas como delivery?",
        answer: "No necesariamente. Podemos complementar los canales existentes creando canales propios para mejorar la relación con los clientes.",
    },
    {
        question: "¿Sirve para cafeterías y pequeños negocios gastronómicos?",
        answer: "Sí. La solución puede adaptarse según el tamaño, tipo de atención y objetivos comerciales del negocio.",
