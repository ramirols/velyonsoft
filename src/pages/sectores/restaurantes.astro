    },
    {
        title: "Ventas por internet",
        description:
            "Catálogos digitales y sistemas de pedidos online para crear canales propios de venta.",
        href: "/soluciones/ventas-por-internet",
        label: "Pedidos",
    },
    {
        title: "Automatización de procesos",
        description:
            "Confirmaciones, mensajes y conexiones automáticas para mejorar atención y operación.",
        href: "/soluciones/automatizacion-de-procesos",
        label: "Automatización",
    },
];

const principles = [
    {
        title: "Más control sobre tus clientes",
        description:
            "Ayudamos a construir canales propios para conocer mejor a quienes compran.",
    },
    {
        title: "Procesos simples para equipos reales",
        description:
            "Las herramientas deben facilitar el trabajo diario, no agregar complejidad.",
    },
    {
        title: "Experiencia rápida para clientes",
        description:
            "Diseñamos soluciones fáciles de usar desde celulares y dispositivos comunes.",
