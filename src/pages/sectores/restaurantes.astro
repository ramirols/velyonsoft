---

<SectorPage
    sector="Restaurantes y gastronomía"
    title="Soluciones digitales para restaurantes que buscan"
    highlight="vender mejor."
    description="Creamos páginas web, canales de venta online y automatizaciones para restaurantes, cafeterías y negocios gastronómicos que necesitan mejorar ventas y operación."
    metaTitle="Soluciones digitales para restaurantes en Perú | Web y pedidos online | Velyon"
    metaDescription="Desarrollamos páginas web para restaurantes, pedidos online, catálogos digitales y automatizaciones para negocios gastronómicos en Perú."
    path="/sectores/restaurantes"
    lottieSrc="/animations/restaurantes.lottie"
    audiences={[
        "Restaurantes",
        "Cafeterías",
        "Dark kitchens",
        "Negocios gastronómicos",
    ]}
    {challenges}
    {solutions}
    {principles}
    product={{
        eyebrow: "Producto para restaurantes",

        title: "Sistema de pedidos y clientes para negocios gastronómicos.",

        description: "Una solución digital en desarrollo para organizar pedidos, clientes, productos y comunicación con consumidores.",

        href: "/productos/sistema-restaurantes",

        status: "En desarrollo",
    }}
