---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Altas comisiones de aplicaciones de delivery intermediarias",
    description:
      "Depender exclusivamente de plataformas de terceros resta entre el 20% y 30% del margen de cada plato vendido, impidiendo construir una relación directa y propia con tus comensales frecuentes.",
  },
  {
    title: "Pedidos caóticos y desordenados por WhatsApp",
    description:
      "Enviar cartas pesadas en PDF que no abren en el celular o recibir mensajes confusos sin especificar guarnición, bebidas o dirección genera pérdidas de tiempo y platos mal preparados.",
  },
  {
    title: "Cartas impresas y cambios de precios costosos",
    description:
      "Actualizar precios, platillos de temporada o avisar de platos agotados en cartas físicas resulta lento y costoso de reimprimir.",
  },
  {
    title: "Poca información para fidelizar al cliente",
    description:
      "Al vender a través de intermediarios externos, no tienes acceso a los números de teléfono, correos o preferencias de tus clientes para lanzar promociones o eventos especiales.",
  },
];

const solutions = [
  {
    title: "Menús interactivos y pedidos organizados a WhatsApp",
    description:
      "Carta digital web ultrarrápida donde el cliente elige sus platos, personaliza opciones y envía el pedido desglosado directamente al WhatsApp de tu restaurante.",
    href: "/soluciones/ventas-por-internet",
    label: "Canal propio de pedidos",
  },
  {
    title: "Páginas web gastronómicas con reserva de mesas",
    description:
      "Sitios web atractivos con fotografías de alta calidad, ubicación en Google Maps, horarios de atención y módulo de reservas para salón.",
    href: "/soluciones/desarrollo-web",
    label: "Presencia y reservas",
  },
  {
    title: "Automatización de confirmaciones y fidelización",
    description:
      "Respuestas automáticas con tiempos estimados de entrega y promociones programadas para clientes que ya han pedido en tu local.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Atención ágil",
  },
];

const principles = [
  {
    title: "Cero comisiones por plato vendido",
    description:
      "El canal digital te pertenece a ti. Todo lo que vendas a través de tu web o catálogo va 100% a la cuenta de tu restaurante.",
  },
  {
    title: "Velocidad absoluta en el celular del cliente",
    description:
      "Sin descargas obligatorias de aplicaciones pesadas: el cliente escanea un código QR o hace clic en tu enlace de Instagram y el menú carga en menos de un segundo.",
  },
  {
    title: "Facilidad de actualización para el personal",
    description:
      "Cambia precios, desactiva platos agotados del día y añade novedades desde un panel intuitivo en segundos.",
  },
  {
    title: "Diseño visual que despierta apetito",
    description:
      "Estructura visual cuidada que destaca tus platos estrella y combos para aumentar el ticket promedio por pedido.",
  },
];

const faqs = [
  {
    question: "¿Cómo funciona el menú digital con pedido a WhatsApp?",
    answer:
      "El cliente ingresa desde su celular, selecciona los platos que desea, añade notas (por ejemplo: 'sin cebolla'), ingresa su dirección y forma de pago. Al presionar 'Enviar Pedido', se abre su WhatsApp con un mensaje perfectamente formateado y calculado listo para confirmar en cocina.",
  },
  {
    question: "¿Tengo que pagar un porcentaje de mis ventas a VelyonSoft?",
    answer:
      "No. Cobramos un costo único y cerrado por el diseño y desarrollo de tu carta web o tienda gastronómica. No cobramos porcentajes ni comisiones por plato vendido.",
  },
  {
    question: "¿Este sistema reemplaza a las aplicaciones como PedidosYa o Rappi?",
    answer:
      "No necesariamente las reemplaza, sino que complementa tu estrategia: te permite canalizar a tus clientes fieles por tu propio sistema directo sin pagar comisión, reservando las apps de terceros únicamente para captar comensales nuevos.",
  },
  {
    question: "¿Sirve para dark kitchens, cafeterías y pollerías?",
    answer:
      "Sí. Es la solución ideal para locales gastronómicos con delivery propio o retiro en tienda, dark kitchens, cafeterías de especialidad, restaurantes turísticos y pastelerías.",
  },
];
---

<SectorPage
  sector="Restaurantes y gastronomía"
  title="Canales propios de pedidos y presencia digital para"
  highlight="restaurantes y gastronomía."
  description="Desarrollamos páginas web, cartas interactivas y sistemas de pedidos directos por WhatsApp para restaurantes, cafeterías y dark kitchens en Perú y Latinoamérica. Vende más a domicilio sin comisiones de intermediarios."
  metaTitle="Páginas Web y Catálogos de Pedidos para Restaurantes | VelyonSoft"
  metaDescription="Desarrollamos páginas web para restaurantes, cartas digitales interactivas y recepción de pedidos por WhatsApp en Perú y Latinoamérica. Vende directo sin comisiones."
  path="/sectores/restaurantes"
  lottieSrc="/animations/restaurantes.lottie"
  audiences={[
    "Restaurantes y pollerías",
    "Cafeterías y pastelerías",
    "Dark kitchens y delivery gastronómico",
    "Bares y locales de comida rápida",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución gastronómica",
    title: "Menú interactivo y pedidos estructurados por WhatsApp.",
    description:
      "Carta digital ligera y responsive para que tus comensales armen su pedido en segundos y lo envíen organizado al chat de tu local.",
    href: "/soluciones/ventas-por-internet",
    status: "Comercio digital propio",
    ctaText: "Ver catálogo para restaurantes",
  }}
  {faqs}
/>