---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Gestión de citas y consultas dispersas",
    description:
      "Las solicitudes de pacientes llegan mezcladas por llamadas, WhatsApp o redes sociales, lo que genera demoras en confirmar, reprogramar turnos o enviar recordatorios.",
  },
  {
    title: "Preguntas repetitivas sobre horarios y servicios",
    description:
      "El personal de recepción invierte gran parte del día respondiendo una y otra vez sobre especialidades, médicos de turno, tarifas y ubicación física del consultorio.",
  },
  {
    title: "Seguimiento administrativo manual y ausencias",
    description:
      "Sin confirmaciones automáticas, la tasa de inasistencia (no-show) de pacientes afecta la productividad de los profesionales de salud.",
  },
  {
    title: "Herramientas desconectadas y hojas de cálculo",
    description:
      "La página informativa, las agendas personales y los registros diarios suelen estar en libretas o archivos de Excel aislados, dificultando la coordinación del equipo.",
  },
];

const solutions = [
  {
    title: "Desarrollo web para el sector salud",
    description:
      "Sitios web médicos profesionales para mostrar especialidades, staff médico, horarios, ubicación y botones de solicitud de cita directos a WhatsApp.",
    href: "/soluciones/desarrollo-web",
    label: "Presencia y confianza",
  },
  {
    title: "Software a medida para consultorios",
    description:
      "Sistemas personalizados para organizar agendas por profesional, registro de turnos y flujos administrativos adaptados a las reglas de tu centro.",
    href: "/soluciones/software-a-medida",
    label: "Gestión a medida",
  },
  {
    title: "Automatización de avisos y recordatorios",
    description:
      "Recordatorios y confirmaciones automáticas por WhatsApp o correo para reducir ausencias de pacientes y liberar tiempo de recepción.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Eficiencia",
  },
];

const principles = [
  {
    title: "Desarrollo a medida vs. Productos cerrados",
    description:
      "No imponemos plataformas rígidas. Evaluamos el flujo de trabajo de tu consultorio y desarrollamos los módulos que realmente necesitas.",
  },
  {
    title: "Privacidad y confidencialidad de datos",
    description:
      "Diseñamos soluciones con control de accesos por roles, bases de datos protegidas y buenas prácticas técnicas de seguridad.",
  },
  {
    title: "Adopción progresiva sin fricción",
    description:
      "Comenzamos por resolver la presencia digital y el agendamiento básico antes de incorporar módulos operativos más complejos.",
  },
  {
    title: "Claridad en el alcance técnico",
    description:
      "Definimos con total transparencia qué funciones se desarrollan y qué integraciones dependen de los sistemas propios del cliente.",
  },
];

const faqs = [
  {
    question: "¿Ofrecen un sistema médico estándar o desarrollo a medida?",
    answer:
      "Ofrecemos desarrollo de software a medida y páginas web profesionales. No vendemos un software empaquetado genérico; diseñamos la agenda, el registro de solicitudes y los paneles administrativos de acuerdo con la especialidad y requerimientos específicos de tu consultorio o clínica.",
  },
  {
    question: "¿Pueden desarrollar sistemas de reserva de citas o agenda médica?",
    answer:
      "Sí. Podemos desarrollar desde formularios interactivos de solicitud conectados a WhatsApp hasta calendarios de disponibilidad por médico y turnos con confirmaciones automatizadas.",
  },
  {
    question: "¿Cómo se maneja la información confidencial de los pacientes?",
    answer:
      "La infraestructura y base de datos se configuran bajo la titularidad del cliente con certificados SSL, cifrado y accesos restringidos por contraseña y perfil de usuario, garantizando que solo el personal autorizado acceda a la información.",
  },
  {
    question: "¿Una página web ayuda a captar nuevos pacientes a un consultorio?",
    answer:
      "Sí. Los pacientes buscan en Google síntomas, tratamientos y especialistas locales. Un sitio web rápido, profesional y optimizado con información clara de especialidades transmite confianza y facilita que el paciente solicite una cita de inmediato.",
  },
];
---

<SectorPage
  sector="Salud y consultorios médicos"
  title="Soluciones digitales y software a medida para consultorios médicos con"
  highlight="atención más organizada."
  description="Desarrollamos páginas web profesionales, sistemas a medida y automatizaciones para consultorios independientes, policlínicos y centros de salud en Perú y Latinoamérica. Optimiza la solicitud de citas, la comunicación con pacientes y el orden administrativo."
  metaTitle="Páginas Web y Software a Medida para Consultorios y Clínicas | VelyonSoft"
  metaDescription="Soluciones digitales y software a medida para consultorios médicos y policlínicos en Perú y LATAM. Presencia profesional, agenda y organización de citas según tus requerimientos."
  path="/sectores/salud"
  lottieSrc="/animations/salud.lottie"
  audiences={[
    "Consultorios médicos y dentales",
    "Policlínicos y centros especializados",
    "Psicólogos y terapeutas",
    "Profesionales independientes de salud",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Desarrollo a medida para salud",
    title: "Sistemas de agendamiento y organización para centros de salud.",
    description:
      "Desarrollo personalizado de herramientas web para gestión de turnos, disponibilidad de profesionales y confirmación de citas, diseñado sobre la operativa real de tu consultorio.",
    href: "/soluciones/software-a-medida",
    status: "Desarrollo a medida",
    ctaText: "Consultar desarrollo para salud",
  }}
  {faqs}
/>
