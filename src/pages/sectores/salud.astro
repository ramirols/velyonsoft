<SectorPage
  sector="Salud"
  title="Soluciones digitales para clínicas y consultorios con"
  highlight="atención más eficiente."
  description="Creamos páginas web, sistemas personalizados y automatizaciones para organizaciones de salud que necesitan mejorar la gestión de citas, comunicación con pacientes y procesos internos."
  metaTitle="Software para clínicas y consultorios en Perú | Soluciones digitales de salud | Velyon"
  metaDescription="Desarrollamos páginas web, sistemas y automatizaciones para clínicas y consultorios en Perú. Digitaliza citas, comunicación y procesos administrativos."
  path="/sectores/salud"
  lottieSrc="/animations/salud.lottie"
  audiences={[
    "Consultorios médicos",
    "Clínicas pequeñas",
    "Centros especializados",
    "Profesionales de salud",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Producto para salud",

    title:
      "Sistema para consultorios: agenda, seguimiento y gestión conectada.",

    description:
      "Una solución digital en desarrollo orientada a organizar citas, seguimiento de pacientes y procesos administrativos mediante herramientas web y móviles.",

    href: "/productos/sistema-para-consultorios",

