---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Solicitudes de cita dispersas",
    description:
      "Llamadas, WhatsApp y formularios llegan por canales distintos y dificultan confirmar o reprogramar a tiempo.",
  },
  {
    title: "Información repetida",
    description:
      "El equipo responde una y otra vez horarios, especialidades, ubicaciones, preparación y disponibilidad.",
  },
  {
    title: "Seguimiento manual",
    description:
      "Los recordatorios y comunicaciones dependen de tareas que pueden olvidarse durante los momentos de mayor carga.",
  },
  {
    title: "Herramientas que no conversan",
    description:
      "La web, la agenda y la operación interna pueden mantener datos separados o exigir doble registro.",
  },
];

const solutions = [
  {
    title: "Desarrollo web",
    description:
      "Sitios claros para presentar especialidades, profesionales, sedes y canales de atención.",
    href: "/soluciones/desarrollo-web",
    label: "Presencia",
  },
  {
    title: "Software a medida",
    description:
      "Paneles, agendas y flujos internos adaptados a la operación del centro.",
    href: "/soluciones/software-a-medida",
    label: "Operación",
  },
  {
    title: "Automatización de procesos",
    description:
      "Confirmaciones, recordatorios e integraciones con controles definidos.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Seguimiento",
  },
];

const principles = [
  {
    title: "Datos mínimos",
    description:
      "Solicitamos únicamente la información necesaria para cada interacción y propósito.",
  },
  {
    title: "Accesos definidos",
    description:
      "Separamos permisos y responsabilidades según el rol de cada usuario.",
  },
  {
    title: "Implementación gradual",
    description:
      "Empezamos por información, contacto y reserva antes de abordar funciones más sensibles.",
  },
  {
    title: "Alcance verificable",
    description:
      "Documentamos qué resuelve la solución, qué integra y qué queda fuera de la primera etapa.",
  },
];

const faqs = [
  {
    question: "¿Una web reemplaza un sistema clínico?",
    answer:
      "No necesariamente. La web puede informar, captar solicitudes o integrarse con una agenda. Un sistema clínico requiere un alcance y controles distintos.",
  },
  {
    question: "¿Pueden desarrollar una reserva de citas?",
    answer:
      "Sí. Puede ir desde una solicitud con confirmación hasta una agenda conectada con disponibilidad y recordatorios, según la operación.",
  },
  {
    question: "¿Cómo se manejan los datos sensibles?",
    answer:
      "Se minimizan los datos, se definen accesos y se seleccionan proveedores apropiados. Las obligaciones legales específicas deben validarse con el responsable del servicio y asesoría especializada.",
  },
  {
    question: "¿La aplicación móvil y el panel web son productos diferentes?",
    answer:
      "No si comparten el mismo objetivo, usuarios y datos. En ese caso son interfaces de un solo producto tecnológico.",
  },
];
---

<SectorPage
  sector="Salud"
  title="Tecnología que ordena la atención sin perder el trato"
  highlight="humano."
  description="Creamos experiencias web, reservas, automatizaciones y sistemas para consultorios y centros de salud que necesitan atender con mayor claridad y continuidad."
  metaTitle="Soluciones tecnológicas para consultorios en Perú | Velyon"
  metaDescription="Páginas web, reservas, automatizaciones y software para consultorios y centros de salud en Perú. Soluciones digitales diseñadas por etapas."
  path="/sectores/salud"
  lottieSrc="/animations/salud.lottie"
  
  audiences={[
    "Consultorios",
    "Centros especializados",
    "Profesionales de salud",
    "Clínicas pequeñas",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Producto para salud",
    title:
      "Sistema para consultorios: agenda, seguimiento y operación conectada.",
    description:
      "Un producto web y móvil en desarrollo para resolver un flujo repetible del sector. Su página explica módulos, usuarios, estado y programa piloto.",
    href: "/productos/sistema-para-consultorios",
    status: "Piloto en desarrollo",
  }}
  {faqs}
/>
