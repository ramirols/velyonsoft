---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Clientes saturando líneas para saber el estado de su envío",
    description:
      "La falta de un sistema de consulta de guía o estado en la web obliga al equipo de atención a responder decenas de llamadas diarias preguntando si el vehículo ya salió o a qué hora llega.",
  },
  {
    title: "Cotización lenta de servicios y pérdida de contratos",
    description:
      "Cuando un cliente corporativo solicita cotizar flete de carga o auxilio de grúa, tardar horas en calcular tarifas por ruta o tonelaje hace que contraten a otro transportista.",
  },
  {
    title: "Guías de remisión y órdenes en papel que se extravían",
    description:
      "Depender de libretas o documentos físicos para registrar conformidades de entrega y firmas genera discrepancias contables y demoras en la facturación.",
  },
  {
    title: "Desconexión entre la base operativa y los choferes en ruta",
    description:
      "La coordinación de viajes, mantenimientos vehiculares y asignación de cargas se maneja en mensajes dispersos sin un historial centralizado.",
  },
];

const solutions = [
  {
    title: "Software a medida para gestión de flotas y despachos",
    description:
      "Plataformas web para registrar clientes, guías, asignación de unidades y choferes, control de kilometraje y costos de viaje.",
    href: "/soluciones/software-a-medida",
    label: "Control operativo",
  },
  {
    title: "Páginas web con cotizador de servicios y consulta de guía",
    description:
      "Sitios web corporativos para empresas de transporte con formularios de cotización rápida y módulos de consulta de estado para clientes.",
    href: "/soluciones/desarrollo-web",
    label: "Presencia y captación",
  },
  {
    title: "Automatización de avisos de despacho por WhatsApp",
    description:
      "Notificaciones automáticas al remitente y destinatario cuando la carga sale a ruta o cuando se registra la entrega final.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Comunicación en ruta",
  },
];

const principles = [
  {
    title: "Simplicidad operativa en el día a día",
    description:
      "Diseñamos paneles sencillos para que coordinadores de transporte registren viajes en segundos sin complicarse con sistemas pesados.",
  },
  {
    title: "Trazabilidad de estados de servicio",
    description:
      "Estados claros: solicitud recibida, unidad asignada, carga en tránsito, entrega conforme con evidencia digital.",
  },
  {
    title: "Disponibilidad desde cualquier navegador",
    description:
      "Sistemas basados en la nube accesibles desde computadoras de oficina, tablets o teléfonos sin instalaciones engorrosas.",
  },
  {
    title: "Seguridad y propiedad del software",
    description:
      "Tu base de datos de clientes, tarifas y rutas es confidencial y pertenece únicamente a tu empresa de transporte.",
  },
];

const faqs = [
  {
    question: "¿Qué tipo de empresas de transporte pueden beneficiarse de estas soluciones?",
    answer:
      "Desarrollamos soluciones para empresas de transporte de carga pesada y liviana, servicios de grúas y auxilio mecánico, operadores de mudanzas, couriers urbanos y empresas de distribución logística.",
  },
  {
    question: "¿Pueden implementar un cotizador de fletes en nuestra página web?",
    answer:
      "Sí. Creamos cotizadores interactivos donde el cliente ingresa origen, destino, tipo de carga o peso, calculando un estimado o enviando la solicitud desglosada al equipo comercial.",
  },
  {
    question: "¿Se puede consultar el estado de un envío desde la web?",
    answer:
      "Sí. Podemos desarrollar un buscador donde el cliente ingresa su número de guía o DNI/RUC y visualiza el estado actual de su despacho sin necesidad de llamar por teléfono.",
  },
  {
    question: "¿El sistema se puede adaptar a las reglas de cobro de mi empresa?",
    answer:
      "Totalmente. Al ser desarrollo a medida, programamos la lógica de precios según tus criterios: por kilómetro, por tonelada, por tipo de vehículo o tarifas fijas por zona.",
  },
];
---

<SectorPage
  sector="Logística, carga y transporte"
  title="Sistemas de gestión y plataformas web para empresas de"
  highlight="transporte y logística."
  description="Desarrollamos software a medida, páginas web corporativas y cotizadores digitales para empresas de transporte de carga, grúas y logística en Perú y Latinoamérica. Optimiza el control de viajes, despachos y atención a clientes."
  metaTitle="Software a Medida para Logística, Carga y Transporte | VelyonSoft"
  metaDescription="Desarrollo de software y páginas web para empresas de transporte de carga, grúas y logística en Perú y Latinoamérica. Cotizadores web y seguimiento operativo."
  path="/sectores/logistica-transporte"
  lottieSrc="/animations/logistica-transporte.lottie"
  audiences={[
    "Empresas de transporte de carga pesada y liviana",
    "Servicios de auxilio mecánico y grúas",
    "Operadores logísticos y distribución",
    "Empresas de courier y paquetería",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución logística",
    title: "Sistemas web de cotización y seguimiento de despachos.",
    description:
      "Herramientas digitales a medida para registrar clientes, asignar unidades vehiculares y brindar seguimiento de carga en tiempo real.",
    href: "/soluciones/software-a-medida",
    status: "Desarrollo a medida",
    ctaText: "Ver desarrollo a medida para transporte",
  }}
  {faqs}
/>