<SectorPage
  sector="Servicios profesionales y consultoría"
  title="Presencia digital y herramientas a medida para"
  highlight="profesionales y consultoras."
  description="Desarrollamos páginas web de autoridad, sistemas de agendamiento y software a medida para estudios de abogados, consultoras, contadores y arquitectos en Perú y Latinoamérica. Posiciona tu firma en Google y convierte tu trayectoria en nuevos clientes."
  metaTitle="Páginas Web y Sistemas para Estudios Profesionales | VelyonSoft"
  metaDescription="Desarrollo web de autoridad y sistemas a medida para estudios de abogados, consultoras, contadores y arquitectos en Perú y Latinoamérica. Capta clientes y proyecta solidez."
  path="/sectores/servicios-profesionales"
  lottieSrc="/animations/servicios-profesionales.lottie"
