<SectorPage
    sector="Servicios profesionales"
    title="Tecnología para profesionales que quieren convertir su experiencia en"
    highlight="nuevas oportunidades."
    description="Creamos páginas web, automatizaciones y sistemas para profesionales y empresas de servicios que necesitan captar clientes, organizar procesos y crecer con mayor orden."
    metaTitle="Soluciones digitales para profesionales en Perú | Velyon"
    metaDescription="Diseñamos páginas web, automatizaciones y sistemas para abogados, consultores, arquitectos y empresas de servicios profesionales en Perú."
    path="/sectores/servicios-profesionales"
    lottieSrc="/animations/servicios-profesionales.lottie"
    audiences={[
        "Consultores",
        "Abogados",
        "Arquitectos",
        "Empresas de servicios",
    ]}
    {challenges}
    {solutions}
    {principles}
    product={{
        eyebrow: "Producto para servicios profesionales",

        title: "Sistema de gestión de clientes y proyectos.",

        description:
            "Una solución digital en desarrollo para organizar clientes, oportunidades comerciales, documentos y seguimiento de servicios.",

