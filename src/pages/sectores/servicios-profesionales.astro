    "Estudios de abogados y asesores jurídicos",
    "Firmas contables y tributarias",
    "Consultoras empresariales y de estrategia",
    "Estudios de arquitectura e ingeniería",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución para firmas profesionales",
    title: "Plataformas web institucionales y gestión de prospectos.",
    description:
      "Sitios web corporativos de alta velocidad con fichas de socios, áreas de práctica detalladas y formularios de contacto calificado.",
    href: "/soluciones/desarrollo-web",
    status: "Desarrollo institucional",
    ctaText: "Ver desarrollo para consultoras",
  }}
  {faqs}
/>