---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Dependencia asfixiante de OTAs (Booking, Airbnb, Expedia)",
    description:
      "Las agencias de viajes online cobran comisiones del 15% al 25% por cada noche reservada, reduciendo drásticamente la rentabilidad del hotel y bloqueando el contacto directo con el huésped.",
  },
  {
    title: "Sitio web lento o poco atractivo para turistas exigentes",
    description:
      "Los viajeros investigan minuciosamente fotos de habitaciones, servicios y opiniones antes de reservar. Una web anticuada o lenta hace que el usuario regrese a Booking para asegurar su estadía.",
  },
  {
    title: "Itinerarios y paquetes turísticos difíciles de cotizar",
    description:
      "Las agencias de viaje pierden horas respondiendo mensajes con preguntas básicas sobre qué incluye el tour, qué días sale o qué tipo de transporte se utiliza.",
  },
  {
    title: "Falta de pasarelas de pago para viajeros internacionales",
    description:
      "No disponer de métodos de pago seguros con tarjeta de crédito en moneda local y dólares dificulta cerrar reservas anticipadas de turistas del extranjero.",
  },
];

const solutions = [
  {
    title: "Desarrollo web para hoteles y hospedajes",
    description:
      "Sitios web visualmente impactantes, con galerías optimizadas de habitaciones, ubicación precisa y llamadas a la acción directas para reservar sin intermediarios.",
    href: "/soluciones/desarrollo-web",
    label: "Reservas directas",
  },
  {
    title: "Catálogos de paquetes turísticos y tours",
    description:
      "Páginas detalladas por itinerario con mapa de ruta, qué incluye, qué no incluye, recomendaciones y botón de consulta o compra.",
    href: "/soluciones/ventas-por-internet",
    label: "Venta de experiencias",
  },
  {
    title: "Automatización de confirmaciones y traslados",
    description:
      "Envío automático de voucher de reserva, indicaciones de llegada y recomendaciones turísticas previas al check-in por WhatsApp o correo.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Experiencia del huésped",
  },
];

const principles = [
  {
    title: "Maximizar el margen de reservas directas",
    description:
      "Diseñamos incentivos claros en la web (mejor tarifa garantizada, beneficios exclusivos) para motivar al viajero a reservar directo en tu sitio.",
  },
  {
    title: "Velocidad de carga global para turistas extranjeros",
    description:
      "Alojamos y optimizamos tu sitio con redes de distribución de contenido (CDN) para que cargue instantáneamente desde Europa, Norteamérica o cualquier país.",
  },
  {
    title: "Diseño optimizado para celulares",
    description:
      "La mayoría de viajeros buscan hoteles y actividades de último minuto directamente desde su smartphone mientras viajan.",
  },
  {
    title: "Autonomía en tarifas y promociones",
    description:
      "Administra fotos de habitaciones, disponibilidad y promociones de temporada baja sin complicaciones técnicas.",
  },
];

const faqs = [
  {
    question: "¿Cómo ayuda una página web a reducir la dependencia de Booking o Airbnb?",
    answer:
      "Muchos viajeros descubren tu hotel en Booking y luego buscan tu sitio web oficial para verificar si existe una mejor tarifa o beneficios directos. Un sitio web oficial profesional, con motor de reserva o contacto directo a WhatsApp, te permite capturar esa reserva sin pagar el 18% o 20% de comisión.",
  },
  {
    question: "¿Pueden integrar pasarelas de pago para cobrar a turistas extranjeros?",
    answer:
      "Sí. Integramos pasarelas internacionales como Stripe, PayPal o Niubiz que permiten cobrar en dólares o moneda local con tarjetas Visa, Mastercard y American Express de cualquier país.",
  },
  {
    question: "¿Sirve para operadores turísticos que venden tours y excursiones?",
    answer:
      "Sí. Diseñamos catálogos de experiencias donde cada tour cuenta con su ficha completa: horarios, fotos, niveles de dificultad, preguntas frecuentes y botón de reserva inmediata.",
  },
  {
    question: "¿Se puede conectar la web con nuestro motor de reservas actual (Channel Manager)?",
    answer:
      "Sí. Si ya utilizas un motor de reservas o Channel Manager (como Cloudbeds, Sirvoy u otros), podemos integrarlo dentro del diseño de tu página web para que las fechas y disponibilidad se sincronicen en automático.",
  },
];
---

<SectorPage
  sector="Hoteles y turismo"
  title="Sitios web y motores de contacto directo para"
  highlight="hoteles y empresas turísticas."
  description="Desarrollamos páginas web para hoteles, lodges, hospedajes y agencias de turismo en Perú y Latinoamérica. Aumenta tus reservas directas, reduce comisiones de plataformas intermediarias y presenta tus paquetes turísticos con excelencia visual."
  metaTitle="Páginas Web y Sistemas de Reserva para Hoteles y Turismo | VelyonSoft"
  metaDescription="Desarrollo web para hoteles, lodges y agencias de turismo en Perú y Latinoamérica. Captación de reservas directas sin comisiones de OTAs y catálogos de tours."
  path="/sectores/hoteles-turismo"
  lottieSrc="/animations/hoteles-turismo.lottie"
  audiences={[
    "Hoteles boutique y lodges",
    "Hospedajes y alojamientos turísticos",
    "Agencias de viajes y operadores de tours",
    "Empresas de transporte turístico",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución para hotelería y tours",
    title: "Portales de captación y reservas directas para turismo.",
    description:
      "Sitios web de alta velocidad diseñados para mostrar habitaciones, tours y paisajes con la máxima fidelidad visual, conectando al viajero directo con tu WhatsApp o pasarela.",
    href: "/soluciones/desarrollo-web",
    status: "Desarrollo web y reservas",
    ctaText: "Ver desarrollo web para turismo",
  }}
  {faqs}
/>