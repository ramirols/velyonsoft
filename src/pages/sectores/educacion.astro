<DetailPage
  eyebrow="Sector · Educación"
  title="Tecnología educativa que facilita la"
  highlight="gestión."
  description="Soluciones digitales para colegios, academias y centros de formación: presencia web, matrícula, pagos, comunicación y procesos internos."
  metaTitle="Sistemas y páginas web para colegios en Perú | Velyon"
  metaDescription="Páginas web, matrícula online, pagos, comunicación y sistemas para colegios, academias y centros educativos en Perú."
  path="/educacion"
  lottieSrc="/animations/educacion.lottie"
  introTitle="Una propuesta especializada para la realidad educativa."
  intro="Esta página es la primera vertical de Velyon. Habla directamente de admisión, estudiantes, familias, docentes, pagos y gestión; no de tecnología genérica."
  {benefits}
  deliverables={[
    "Web institucional",
    "Admisión y matrícula online",
    "Portal para familias",
    "Asistencia y seguimiento",
    "Pensiones y cobranzas",
    "Comunicaciones y avisos",
    "Panel administrativo",
    "Soporte mensual",
  ]}
