---
import SectorPage from "@/components/SectorPage.astro";

const challenges = [
  {
    title: "Procesos de admisión desbordados en temporada alta",
    description:
      "Las consultas de padres y postulantes llegan simultáneamente por redes sociales, formularios y llamadas, haciendo difícil dar seguimiento a cada familia interesada y concretar matrículas a tiempo.",
  },
  {
    title: "Comunicación institucional fragmentada",
    description:
      "Los comunicados oficiales, circulares, cronogramas de exámenes y eventos se comparten por múltiples grupos de WhatsApp o fotocopias, generando confusión entre docentes, alumnos y familias.",
  },
  {
    title: "Gestión de matrículas y pagos manuales",
    description:
      "La recepción de comprobantes de pago por chat, la verificación manual con el banco y el llenado físico de fichas de matrícula consumen semanas de trabajo administrativo innecesario.",
  },
  {
    title: "Web institucional desactualizada o poco atractiva",
    description:
      "La página web del centro educativo no transmite la calidad académica ni la infraestructura real, perdiendo postulantes frente a otras instituciones con mejor presencia digital.",
  },
];

const solutions = [
  {
    title: "Desarrollo web para instituciones educativas",
    description:
      "Sitios web institucionales rápidos y modernos para presentar propuesta pedagógica, niveles educativos, infraestructura, actividades y canales de admisión.",
    href: "/soluciones/desarrollo-web",
    label: "Presencia y prestigio",
  },
  {
    title: "Plataformas y sistemas de matrícula a medida",
    description:
      "Módulos web para registro de postulantes, carga de documentos digitales, seguimiento de vacantes y confirmación de matrícula.",
    href: "/soluciones/software-a-medida",
    label: "Gestión de admisión",
  },
  {
    title: "Automatización de avisos y recordatorios",
    description:
      "Envío automatizado de confirmaciones de inscripción, fechas clave y recordatorios por correo o WhatsApp para reducir ausencias.",
    href: "/soluciones/automatizacion-de-procesos",
    label: "Comunicación ágil",
  },
];

const principles = [
  {
    title: "Diseño pensado en familias y postulantes",
    description:
      "La información de costos, requisitos de ingreso y beneficios educativos debe encontrarse en menos de dos clics desde cualquier teléfono móvil.",
  },
  {
    title: "Desarrollo modular por etapas",
    description:
      "Comenzamos resolviendo el portal informativo y la captación de admisión antes de abordar sistemas académicos o aulas virtuales más densas.",
  },
  {
    title: "Autonomía para el equipo del colegio",
    description:
      "Entregamos paneles fáciles de usar para que secretaría o coordinación académica puedan publicar comunicados y fotos sin depender de un programador.",
  },
  {
    title: "Propiedad exclusiva de la institución",
    description:
      "El dominio oficial (.edu.pe o .com) y la base de datos de postulantes quedan bajo el control absoluto de la institución educativa.",
  },
];

const faqs = [
  {
    question: "¿Qué tipo de instituciones educativas atienden?",
    answer:
      "Desarrollamos soluciones para colegios privados de inicial, primaria y secundaria, academias de preparación preuniversitaria, institutos técnicos, centros de idiomas y escuelas de negocios.",
  },
  {
    question: "¿Pueden implementar un sistema de postulación y matrícula online?",
    answer:
      "Sí. Diseñamos plataformas web donde los padres pueden registrar los datos del estudiante, adjuntar documentos en PDF y recibir la confirmación de vacante y proceso de matrícula de forma organizada.",
  },
  {
    question: "¿Desarrollan aulas virtuales (LMS) o se enfocan en la web y admisión?",
    answer:
      "Nos especializamos en el portal institucional, la captación de alumnos, la admisión digital y sistemas de gestión administrativa. Si la institución requiere un aula virtual, podemos integrar plataformas reconocidas como Moodle o Google Workspace for Education mediante accesos directos unificados.",
  },
  {
    question: "¿Cuánto tiempo toma tener lista una web para la campaña de matrículas?",
    answer:
      "Un portal institucional con módulo de admisión suele desarrollarse y lanzarse en 2 a 3 semanas, garantizando que esté completamente operativo antes del inicio de la temporada fuerte de inscripciones.",
  },
];
---

<SectorPage
  sector="Educación y centros formativos"
  title="Plataformas web y sistemas de matrícula adaptados a"
  highlight="instituciones educativas."
  description="Desarrollamos páginas web institucionales, sistemas de admisión y herramientas digitales a medida para colegios, academias e institutos en Perú y Latinoamérica. Mejora la captación de nuevos estudiantes y digitaliza procesos administrativos."
  metaTitle="Soluciones Digitales y Sistemas para Colegios y Academias | VelyonSoft"
  metaDescription="Desarrollamos páginas web institucionales, plataformas de admisión y sistemas de matrícula a medida para colegios, academias y centros educativos en Perú y LATAM."
  path="/sectores/educacion"
  lottieSrc="/animations/educacion.lottie"
  audiences={[
    "Colegios particulares",
    "Academias y centros preuniversitarios",
    "Institutos y escuelas de capacitación",
    "Centros de idiomas y formación continua",
  ]}
  {challenges}
  {solutions}
  {principles}
  product={{
    eyebrow: "Solución para educación",
    title: "Portales institucionales y sistemas de admisión escolar.",
    description:
      "Sitios web de alta velocidad con módulos de recepción de prospectos, descarga de folletos informativos y gestión de postulaciones para centros educativos.",
    href: "/soluciones/desarrollo-web",
    status: "Desarrollo institucional",
    ctaText: "Ver desarrollo para colegios",
  }}
  {faqs}
/>