---
import { ArrowRight, ExternalLink } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
import { siteConfig } from "@/lib/site";

const pageUrl = new URL("/proyectos", siteConfig.url).href;

const schema = [
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: "Proyectos realizados por Velyon",
        description:
            "Portafolio de proyectos digitales desarrollados por Velyon.",
        url: pageUrl,
    },
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        itemListElement: projects.map((project, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: project.name,
            url: project.url,
        })),
    },
];

const featuredProjects = projects
    .filter((project) => project.featured)
    .slice(0, 3);

const normalProjects = projects.filter((project) => !project.featured);

const stats = [
    {
        number: "+40",
        label: "proyectos desarrollados",
    },
    {
        number: "5+",
        label: "años creando soluciones",
    },
    {
        number: "10+",
        label: "sectores trabajados",
    },
];
---

<BaseLayout
    title="Proyectos realizados | Velyon"
    description="Conoce proyectos digitales desarrollados por Velyon."
    schema={schema}
>
    <main>
        <!-- HERO -->

        <section class="bg-velyon-mist py-[120px] max-[640px]:py-20">
            <div class="container-velyon">
                <div class="max-w-[900px]">
                    <span class="section-label"> Portafolio Velyon </span>

                    <h1
                        class="mt-6 font-display text-[clamp(3rem,6vw,5.8rem)] font-bold leading-[.95] tracking-[-0.07em]"
                    >
                        Construimos experiencias digitales para negocios que
                        quieren

                        <span class="font-serif italic text-velyon-deep">
                            crecer mejor.
                        </span>
                    </h1>

                    <p
                        class="mt-8 max-w-[650px] text-lg leading-8 text-muted-foreground"
                    >
                        Desde páginas web hasta sistemas personalizados, cada
                        proyecto nace desde una necesidad real: vender más,
                        ordenar procesos o mejorar la experiencia de sus
                        clientes.
                    </p>
                </div>

                <!-- STATS -->

                <div
                    class="mt-16 flex flex-wrap divide-x divide-border rounded-[24px] border border-border bg-white max-[700px]:divide-x-0"
                >
                    {
                        stats.map((stat) => (
                            <div class="flex-1 min-w-[220px] px-8 py-7 max-[700px]:border-b max-[700px]:border-border">
                                <strong class="font-display text-4xl font-bold tracking-tight text-velyon-deep">
                                    {stat.number}
                                </strong>

                                <p class="mt-2 text-sm font-semibold text-muted-foreground">
                                    {stat.label}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- FEATURED -->

        <section class="bg-white py-[120px] max-[640px]:py-20">
            <div class="container-velyon">
                <div class="mb-14">
                    <span class="section-label">
                        01 — Proyectos destacados
                    </span>

                    <h2 class="section-title max-w-[700px]">
                        Algunos proyectos donde la tecnología se convirtió en
                        una herramienta de negocio.
                    </h2>
                </div>

                <div class="grid grid-cols-12 gap-6">
                    {
                        featuredProjects.map((project, index) => (
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class:list={[
                                    "group relative overflow-hidden rounded-[30px] border border-border bg-white",

                                    index === 0
                                        ? "col-span-7 min-h-[620px] max-[900px]:col-span-12"
                                        : "col-span-5 min-h-[300px] max-[900px]:col-span-6 max-[600px]:col-span-12",
                                ]}
                            >
                                <div class="absolute inset-0">
                                    {project.image && (
                                        <img
                                            src={project.image}
                                            alt={project.name}
                                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                        />
                                    )}

                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
                                </div>

                                <div class="relative flex h-full flex-col justify-end p-8 text-white">
                                    <span class="w-fit rounded-full bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider backdrop-blur">
                                        {project.category}
                                    </span>

                                    <h3
                                        class:list={[
                                            "mt-5 font-display font-bold tracking-tight",

                                            index === 0
                                                ? "text-4xl"
                                                : "text-2xl",
                                        ]}
                                    >
                                        {project.name}
                                    </h3>

                                    <p class="mt-3 max-w-[420px] text-sm leading-6 text-white/75">
                                        {project.description}
                                    </p>

                                    <div class="mt-6 flex items-center gap-2 text-xs font-bold">
                                        Ver proyecto
                                        <ExternalLink class="size-4" />
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ALL PROJECTS -->

        <section class="bg-velyon-mist py-[120px] max-[640px]:py-20">
            <div class="container-velyon">
                <div
                    class="mb-12 flex items-end justify-between gap-8 max-[700px]:flex-col"
                >
                    <div>
                        <span class="section-label"> 02 — Más proyectos </span>

                        <h2 class="section-title">
                            Otros trabajos realizados.
                        </h2>
                    </div>

                    <p
                        class="max-w-[380px] text-sm leading-7 text-muted-foreground"
                    >
                        Explora proyectos adicionales de páginas web, ecommerce,
                        sistemas y soluciones digitales.
                    </p>
                </div>

                <div
                    class="grid grid-cols-3 gap-5 max-[950px]:grid-cols-2 max-[650px]:grid-cols-1"
                >
                    {
                        normalProjects.map((project) => (
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group overflow-hidden rounded-[24px] border border-border bg-white transition hover:-translate-y-1 hover:shadow-xl"
                            >
                                <div class="aspect-[16/10] overflow-hidden bg-white">
                                    {project.image && (
                                        <img
                                            src={project.image}
                                            alt={project.name}
                                            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                        />
                                    )}
                                </div>

                                <div class="p-6">
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-velyon-deep">
                                        {project.category}
                                    </span>

                                    <h3 class="mt-3 font-display text-xl font-bold tracking-tight">
                                        {project.name}
                                    </h3>

                                    <p class="mt-3 text-sm leading-7 text-muted-foreground">
                                        {project.description}
                                    </p>

                                    <div class="mt-5 flex items-center gap-2 text-xs font-bold text-velyon-deep">
                                        Visitar proyecto
                                        <ExternalLink class="size-3.5" />
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- CTA -->

        <section class="bg-velyon-deep py-[110px] text-white">
            <div class="container-velyon">
                <div
                    class="flex items-end justify-between gap-10 max-[750px]:flex-col"
                >
                    <div>
                        <span class="section-label !text-velyon-mint">
                            ¿Tienes una idea?
                        </span>

                        <h2
                            class="mt-5 max-w-[760px] font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-tight tracking-[-0.055em]"
                        >
                            Creamos la solución digital que tu negocio necesita.
                        </h2>
                    </div>

                    <a href="/diagnostico" class="btn-light">
                        Solicitar diagnóstico

                        <ArrowRight class="size-4" />
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>