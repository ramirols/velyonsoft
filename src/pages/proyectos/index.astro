---
import { ArrowRight, ChevronLeft, ChevronRight, ExternalLink, Lock, MessageSquare } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { publicProjects, portfolioProjects } from "@/data/projects";
import { siteConfig, whatsappUrl } from "@/lib/site";

const pageUrl = new URL("/proyectos", siteConfig.url).href;

const allVisibleProjects = [...publicProjects, ...portfolioProjects];

const schema = [
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: "Portafolio de Proyectos | VelyonSoft",
        description:
            "Portafolio completo de tiendas online, páginas web y sistemas a medida desarrollados por VelyonSoft en Perú.",
        url: pageUrl,
    },
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        itemListElement: allVisibleProjects.map((project, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: project.name,
            description: project.description,
            url: project.url !== "#" ? project.url : `${pageUrl}#${project.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`,
        })),
    },
];

const stats = [
    {
        number: "En vivo",
        label: "tiendas y webs en producción",
    },
    {
        number: "0 plantillas",
        label: "código moderno, ligero y rápido",
    },
    {
        number: "Directo",
        label: "trato y soporte con el desarrollador",
    },
];
---

<BaseLayout
    title="Portafolio de Proyectos Web y Sistemas en Producción | VelyonSoft"
    description="Conoce proyectos reales de tiendas online, páginas web corporativas y desarrollo de software a medida construidos por VelyonSoft para empresas de Perú y LATAM."
    schema={schema}
>
    <main>
        <!-- HERO -->

        <section class="bg-velyon-mist py-[120px] max-[640px]:py-20">
            <div class="container-velyon">
                <div class="max-w-[900px]">
                    <span class="section-label"> Portafolio VelyonSoft </span>

                    <h1
                        class="mt-6 font-display text-[clamp(2.8rem,5.5vw,5rem)] font-bold leading-[1.02] tracking-[-0.06em]"
                    >
                        Proyectos y desarrollos construidos para negocios que quieren

                        <span class="font-serif italic text-velyon-deep">
                            vender y operar mejor.
                        </span>
                    </h1>

                    <p
                        class="mt-8 max-w-[650px] text-lg leading-8 text-muted-foreground"
                    >
                        Desde tiendas online y plataformas web institucionales hasta sistemas
                        internos a medida. Cada proyecto responde a un objetivo comercial concreto:
                        vender más, digitalizar procesos o eliminar tareas manuales.
                    </p>
                </div>

                <!-- STATS -->

                <div
                    class="mt-16 flex flex-wrap divide-x divide-border rounded-[24px] border border-border bg-white max-[700px]:divide-x-0"
                >
                    {
                        stats.map((stat) => (
                            <div class="flex-1 min-w-[220px] px-8 py-7 max-[700px]:border-b max-[700px]:border-border">
                                <span class="font-display text-4xl font-bold tracking-tight text-velyon-deep">
                                    {stat.number}
                                </span>

                                <p class="mt-2 text-sm font-semibold text-muted-foreground">
                                    {stat.label}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 01: DESTACADOS COMERCIALES (2 CASOS) -->

        <section class="bg-white py-[120px] max-[640px]:py-20">
            <div class="container-velyon">
                <div class="mb-14">
                    <span class="section-label">
                        01 — Casos destacados
                    </span>

                    <h2 class="section-title max-w-[700px]">
                        Proyectos con presencia digital y resultados activos.
                    </h2>
                </div>

                <div class="grid grid-cols-2 gap-6 max-[900px]:grid-cols-1">
                    {
                        publicProjects.map((project) => (
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group relative min-h-[500px] overflow-hidden rounded-[30px] border border-border bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_25px_60px_rgba(20,50,44,.12)] max-[640px]:min-h-[380px]"
                            >
                                <div class="absolute inset-0">
                                    {project.image && (
                                        <img
                                            src={project.image}
                                            alt={project.name}
                                            loading="lazy"
                                            decoding="async"
                                            width="600"
                                            height="500"
                                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                        />
                                    )}

                                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent" />
                                </div>

                                <div class="relative flex h-full flex-col justify-end p-8 text-white max-[640px]:p-6">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="w-fit rounded-full bg-white/15 px-3 py-1 text-[10px] font-bold uppercase tracking-wider backdrop-blur">
                                            {project.category}
                                        </span>
                                        <span class="w-fit rounded-full bg-velyon-mint/30 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-velyon-mint backdrop-blur">
                                            {project.typeLabel}
                                        </span>
                                    </div>

                                    <h3 class="mt-5 font-display text-3xl font-bold tracking-tight max-[640px]:text-2xl">
                                        {project.name}
                                    </h3>

                                    <p class="mt-3 max-w-[460px] text-sm leading-6 text-white/80">
                                        {project.description}
                                    </p>

                                    <div class="mt-6 flex items-center gap-2 text-xs font-bold text-white">
                                        Visitar sitio oficial
                                        <ExternalLink class="size-4" />
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 02: CATÁLOGO COMPLETO DE PROYECTOS -->

        <section id="catalogo-proyectos" class="scroll-mt-24 bg-velyon-mist py-[120px] max-[640px]:py-20">
            <div class="container-velyon">
                <div
                    class="mb-14 flex items-end justify-between gap-8 max-[700px]:flex-col"
                >
                    <div>
                        <span class="section-label"> 02 — Catálogo de proyectos </span>

                        <h2 class="section-title">
                            Plataformas web y desarrollos a medida.
                        </h2>
                    </div>

                    <p
                        class="max-w-[420px] text-sm leading-7 text-muted-foreground"
                    >
                        Soluciones desarrolladas para clientes con sitios web públicos y sistemas
                        operativos implementados para necesidades específicas de negocio.
                    </p>
                </div>

                <div
                    id="projects-grid"
                    class="grid grid-cols-3 gap-6 max-[1024px]:grid-cols-2 max-[640px]:grid-cols-1"
                >
                    {
                        portfolioProjects.map((project) =>
                            project.url && project.url !== "#" ? (
                                <a
                                    href={project.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    id={project.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
                                    data-project-card
                                    class="group flex flex-col overflow-hidden rounded-[24px] border border-border bg-white transition hover:-translate-y-1 hover:shadow-xl"
                                >
                                    <div class="aspect-[16/10] overflow-hidden bg-velyon-mist">
                                        {project.image && (
                                            <img
                                                src={project.image}
                                                alt={project.name}
                                                loading="lazy"
                                                decoding="async"
                                                width="400"
                                                height="250"
                                                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                            />
                                        )}
                                    </div>

                                    <div class="flex flex-1 flex-col justify-between p-6">
                                        <div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="rounded-full bg-velyon-mist px-2.5 py-1 text-[9px] font-bold uppercase tracking-widest text-velyon-deep">
                                                    {project.category}
                                                </span>
                                                <span class="rounded-full bg-velyon-mint-soft px-2.5 py-1 text-[9px] font-bold text-velyon-deep">
                                                    {project.typeLabel}
                                                </span>
                                            </div>

                                            <h3 class="mt-3 font-display text-xl font-bold tracking-tight text-foreground">
                                                {project.name}
                                            </h3>

                                            <p class="mt-3 text-sm leading-6 text-muted-foreground">
                                                {project.description}
                                            </p>
                                        </div>

                                        <div class="mt-6 flex items-center gap-2 text-xs font-bold text-velyon-deep">
                                            Visitar sitio web oficial
                                            <ExternalLink class="size-3.5" />
                                        </div>
                                    </div>
                                </a>
                            ) : (
                                <article
                                    id={project.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
                                    data-project-card
                                    class="flex flex-col overflow-hidden rounded-[24px] border border-border bg-white shadow-sm"
                                >
                                    <div class="aspect-[16/10] overflow-hidden bg-velyon-mist">
                                        {project.image && (
                                            <img
                                                src={project.image}
                                                alt={project.name}
                                                loading="lazy"
                                                decoding="async"
                                                width="400"
                                                height="250"
                                                class="h-full w-full object-cover"
                                            />
                                        )}
                                    </div>

                                    <div class="flex flex-1 flex-col justify-between p-6">
                                        <div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="rounded-full bg-velyon-mist px-2.5 py-1 text-[9px] font-bold uppercase tracking-widest text-velyon-deep">
                                                    {project.category}
                                                </span>
                                                <span class="rounded-full bg-muted/60 px-2.5 py-1 text-[9px] font-semibold text-muted-foreground">
                                                    {project.typeLabel}
                                                </span>
                                            </div>

                                            <h3 class="mt-3 font-display text-xl font-bold tracking-tight text-foreground">
                                                {project.name}
                                            </h3>

                                            <p class="mt-3 text-sm leading-6 text-muted-foreground">
                                                {project.description}
                                            </p>
                                        </div>

                                        <div class="mt-6 flex items-center gap-2 text-[11px] font-medium text-muted-foreground">
                                            <Lock class="size-3 shrink-0 text-muted-foreground/70" />
                                            <span>Desarrollo a medida · Sin demo pública</span>
                                        </div>
                                    </div>
                                </article>
                            ),
                        )
                    }
                </div>

                <!-- PAGINACIÓN DE 9 EN 9 -->
                <nav
                    id="pagination-container"
                    aria-label="Paginación del catálogo de proyectos"
                    class="mt-12 flex flex-col items-center justify-between gap-5 rounded-2xl border border-border bg-white p-5 shadow-sm sm:flex-row"
                >
                    <p class="text-sm font-medium text-muted-foreground">
                        Mostrando <span id="page-range" class="font-bold text-foreground">1–9</span> de <span class="font-bold text-foreground">{portfolioProjects.length}</span> proyectos
                    </p>

                    <div class="flex flex-wrap items-center gap-2" id="pagination-controls">
                        <button
                            type="button"
                            id="btn-prev-page"
                            class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-border bg-white px-3.5 text-xs font-bold text-foreground shadow-xs transition hover:bg-velyon-mist disabled:cursor-not-allowed disabled:opacity-40"
                            aria-label="Página anterior"
                        >
                            <ChevronLeft class="size-4" />
                            <span>Anterior</span>
                        </button>

                        <div id="page-numbers" class="flex items-center gap-1.5">
                            <!-- Los botones numéricos se generan dinámicamente -->
                        </div>

                        <button
                            type="button"
                            id="btn-next-page"
                            class="inline-flex h-10 items-center justify-center gap-1.5 rounded-xl border border-border bg-white px-3.5 text-xs font-bold text-foreground shadow-xs transition hover:bg-velyon-mist disabled:cursor-not-allowed disabled:opacity-40"
                            aria-label="Página siguiente"
                        >
                            <span>Siguiente</span>
                            <ChevronRight class="size-4" />
                        </button>
                    </div>
                </nav>
            </div>
        </section>

        <script is:inline>
            function initProjectsPagination() {
                const grid = document.getElementById("projects-grid");
                if (!grid) return;
                const cards = Array.from(grid.querySelectorAll("[data-project-card]"));
                const total = cards.length;
                if (total === 0) return;

                const itemsPerPage = 9;
                const totalPages = Math.ceil(total / itemsPerPage);
                let currentPage = 1;

                // Sync with URL query parameter '?p=...'
                const urlParams = new URLSearchParams(window.location.search);
                const queryPage = parseInt(urlParams.get("p") || "1", 10);
                if (!isNaN(queryPage) && queryPage >= 1 && queryPage <= totalPages) {
                    currentPage = queryPage;
                }

                const pageRange = document.getElementById("page-range");
                const prevBtn = document.getElementById("btn-prev-page");
                const nextBtn = document.getElementById("btn-next-page");
                const pageNumbersContainer = document.getElementById("page-numbers");

                function applyPagination(page, shouldScroll = false) {
                    currentPage = page;
                    const startIdx = (currentPage - 1) * itemsPerPage;
                    const endIdx = Math.min(startIdx + itemsPerPage, total);

                    cards.forEach((card, index) => {
                        if (index >= startIdx && index < endIdx) {
                            card.classList.remove("hidden");
                        } else {
                            card.classList.add("hidden");
                        }
                    });

                    if (pageRange) {
                        pageRange.textContent = `${startIdx + 1}–${endIdx}`;
                    }

                    if (prevBtn) {
                        prevBtn.disabled = currentPage === 1;
                    }
                    if (nextBtn) {
                        nextBtn.disabled = currentPage === totalPages;
                    }

                    if (pageNumbersContainer) {
                        pageNumbersContainer.innerHTML = "";
                        for (let i = 1; i <= totalPages; i++) {
                            const btn = document.createElement("button");
                            btn.type = "button";
                            btn.setAttribute("aria-label", "Página " + i);
                            btn.className = i === currentPage
                                ? "inline-flex size-10 items-center justify-center rounded-xl bg-velyon-deep font-display text-sm font-bold text-white shadow-xs transition"
                                : "inline-flex size-10 items-center justify-center rounded-xl border border-border bg-white font-display text-sm font-semibold text-foreground transition hover:bg-velyon-mist";
                            if (i === currentPage) {
                                btn.setAttribute("aria-current", "page");
                            }
                            btn.textContent = String(i);
                            btn.addEventListener("click", () => {
                                applyPagination(i, true);
                            });
                            pageNumbersContainer.appendChild(btn);
                        }
                    }

                    const newUrl = new URL(window.location.href);
                    if (currentPage > 1) {
                        newUrl.searchParams.set("p", String(currentPage));
                    } else {
                        newUrl.searchParams.delete("p");
                    }
                    window.history.replaceState({}, "", newUrl.toString());

                    if (shouldScroll) {
                        const catalogSection = document.getElementById("catalogo-proyectos");
                        if (catalogSection) {
                            catalogSection.scrollIntoView({ behavior: "smooth", block: "start" });
                        }
                    }
                }

                if (prevBtn) {
                    prevBtn.onclick = () => {
                        if (currentPage > 1) {
                            applyPagination(currentPage - 1, true);
                        }
                    };
                }

                if (nextBtn) {
                    nextBtn.onclick = () => {
                        if (currentPage < totalPages) {
                            applyPagination(currentPage + 1, true);
                        }
                    };
                }

                applyPagination(currentPage, false);
            }

            document.addEventListener("astro:page-load", initProjectsPagination);
            if (document.readyState !== "loading") {
                initProjectsPagination();
            } else {
                document.addEventListener("DOMContentLoaded", initProjectsPagination);
            }
        </script>

        <!-- CTA COMERCIAL -->

        <section class="bg-velyon-deep py-[110px] text-white">
            <div class="container-velyon">
                <div
                    class="flex items-end justify-between gap-10 max-[750px]:flex-col"
                >
                    <div>
                        <span class="section-label !text-velyon-mint">
                            ¿Tienes un proyecto en mente?
                        </span>

                        <h2
                            class="mt-5 max-w-[760px] font-display text-[clamp(2.4rem,5vw,4rem)] font-bold leading-tight tracking-[-0.055em]"
                        >
                            Conversemos directamente sobre la solución que tu negocio necesita.
                        </h2>
                    </div>

                    <div class="flex flex-wrap gap-4">
                        <a
                            href={whatsappUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-light"
                        >
                            <MessageSquare class="size-4" />
                            Conversar por WhatsApp
                        </a>
                        <a href="/diagnostico" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 text-sm font-bold text-white transition hover:bg-white/20">
                            Diagnóstico en línea
                            <ArrowRight class="size-4" />
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>