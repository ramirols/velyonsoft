---
interface Props {
  src?: string;
  label?: string;
  class?: string;
}

const {
  src = "/animations/velyon.lottie",
  label = "Animación de tecnología conectada",
  class: className = "",
} = Astro.props;

const verifiedAnimations = new Set([
  "/animations/velyon.lottie",
  "/animations/desarrollo-web.lottie",
  "/animations/ventas-por-internet.lottie",
  "/animations/automatizacion-y-sistemas.lottie",
  "/animations/salud.lottie",
  "/animations/educacion.lottie",
  "/animations/negocios-y-servicios.lottie",
]);

const safeSrc = verifiedAnimations.has(src) ? src : "/animations/velyon.lottie";
---

<div
  class:list={["lottie-shell", className]}
  data-lottie
  data-src={safeSrc}
  role="img"
  aria-label={label}
>
  <canvas class="h-full w-full" aria-hidden="true"></canvas>

  <noscript>
    <img
      src="/brand/isotipo-velyon-color.svg"
      width="180"
      height="180"
      alt="Velyon"
      loading="lazy"
      decoding="async"
    />
  </noscript>
</div>

<script>
  function initLotties() {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const elements = document.querySelectorAll<HTMLElement>(
      "[data-lottie]:not([data-ready])",
    );
    if (!elements.length) return;

    async function loadLottie(container: HTMLElement) {
      if (container.dataset.ready) return;
      container.dataset.ready = "true";

      const canvas = container.querySelector<HTMLCanvasElement>("canvas");
      const src = container.dataset.src;
      if (!canvas || !src) return;

      try {
        const { DotLottie } = await import("@lottiefiles/dotlottie-web");
        const player = new DotLottie({
          canvas,
          src,
          loop: !reduceMotion,
          autoplay: true,
        });

        if (reduceMotion) {
          player.setFrame(0);
        }
      } catch (err) {
        console.warn("Lottie player failed to load", err);
      }
    }

    if (!("IntersectionObserver" in window)) {
      elements.forEach((el) => {
        if (el.offsetParent !== null) {
          loadLottie(el);
        }
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            if (target.offsetParent !== null) {
              obs.unobserve(target);
              loadLottie(target);
            }
          }
        });
      },
      { rootMargin: "200px 0px" },
    );

    elements.forEach((container) => {
      // Don't observe if display:none (e.g. mobile hidden hero)
      const isHidden = window.getComputedStyle(container).display === "none";
      if (isHidden) return;
      observer.observe(container);
    });
  }

  const scheduleInit = () => {
    if ("requestIdleCallback" in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => number }).requestIdleCallback(() => initLotties());
    } else {
      setTimeout(initLotties, 80);
    }
  };

  scheduleInit();
  document.addEventListener("astro:page-load", scheduleInit);
</script>
