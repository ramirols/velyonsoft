---
import { ArrowRight, Check, Plus, TrendingUp } from "@lucide/astro";
import LottieAnimation from "@/components/LottieAnimation.astro";
---

<section
  id="inicio"
  class="container-velyon grid min-h-[690px] grid-cols-[.94fr_1.06fr] items-center gap-16 py-[92px] max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[900px]:py-[72px] max-[640px]:py-14"
>
  <div class="max-w-[650px]">
    <div
      class="mb-6 flex items-center gap-2.5 text-xs font-extrabold uppercase tracking-[0.11em] text-velyon-deep max-[640px]:text-[10px]"
    >
      <span class="h-0.5 w-7 bg-velyon-mint"></span>
      Estudio de soluciones tecnológicas
    </div>
    <h1
      class="font-display text-[clamp(3rem,5.7vw,4.75rem)] font-bold leading-[.99] tracking-[-0.065em] text-velyon-ink"
    >
      Tecnología para vender más y
      <em class="block font-serif font-medium text-velyon-deep"
        >operar mejor.</em
      >
    </h1>
    <p
      class="mt-7 max-w-[610px] text-lg leading-8 text-muted-foreground max-[640px]:text-base"
    >
      Creamos páginas web, tiendas online, automatizaciones y sistemas que
      ayudan a negocios peruanos a crecer con más orden y menos trabajo manual.
    </p>
    <div
      class="mt-8 flex items-center gap-6 max-[640px]:flex-col max-[640px]:items-stretch"
    >
      <a class="btn-primary" href="#contacto"
        >Solicitar diagnóstico <ArrowRight
          class="size-4"
          aria-hidden="true"
        /></a
      >
      <a class="text-link max-[640px]:justify-center" href="#soluciones"
        >Explorar soluciones <ArrowRight class="size-4" aria-hidden="true" /></a
      >
    </div>
    <div
      class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-xs font-semibold text-[#515a57] max-[640px]:grid"
    >
      {
        ["Diagnóstico inicial", "Propuesta clara", "Soporte continuo"].map(
          (item) => (
            <span class="flex items-center gap-2">
              <span class="check-dot">
                <Check class="size-3" stroke-width="3" aria-hidden="true" />
              </span>
              {item}
            </span>
          ),
        )
      }
    </div>
  </div>

  <div
    class="relative grid min-h-[480px] place-items-center max-[640px]:min-h-[390px]"
    aria-label="Vista conceptual de una solución Velyon"
  >
    <div
      class="absolute inset-[20px_8px_0_42px] rotate-2 rounded-[54px_16px_54px_16px] bg-gradient-to-br from-velyon-mint-soft to-velyon-lavender-soft max-[640px]:inset-[10px_3px_0_10px] max-[640px]:rounded-[30px_12px_30px_12px]"
    >
    </div>
    <div
      class="soft-shadow relative z-10 w-full max-w-[610px] -rotate-[1.3deg] overflow-hidden rounded-[20px] border border-velyon-deep/15 bg-white max-[640px]:rotate-0 max-[640px]:rounded-2xl"
    >
      <div
        class="grid h-14 grid-cols-[1fr_auto_1fr] items-center border-b border-[#e6ebe9] bg-[#fbfcfc] px-4"
      >
        <span class="flex gap-1.5" aria-hidden="true"
          ><i class="size-2 rounded-full bg-velyon-mint"></i><i
            class="size-2 rounded-full bg-[#cad2cf]"></i><i
            class="size-2 rounded-full bg-[#cad2cf]"></i></span
        >
        <span class="text-[11px] font-bold text-[#5f6865]"
          >Panel del negocio</span
        >
        <span
          class="justify-self-end rounded-full bg-velyon-mint-soft px-2.5 py-1 text-[10px] font-bold text-velyon-deep"
          >En línea</span
        >
      </div>
      <div class="bg-[#f8faf9] p-5 max-[640px]:p-3">
        <div class="grid grid-cols-2 gap-3 max-[430px]:grid-cols-1">
          <article class="rounded-[14px] border border-[#e2e8e6] bg-white p-4">
            <span class="block text-[11px] font-semibold text-[#66706d]"
              >Consultas este mes</span
            >
            <strong class="my-2 block font-display text-[28px] tracking-tight"
              >184</strong
            >
            <small
              class="flex items-center gap-1 text-[9px] font-semibold text-velyon-deep"
              ><TrendingUp class="size-3" /> 22% vs. mes anterior</small
            >
          </article>
          <article class="rounded-[14px] border border-[#e2e8e6] bg-white p-4">
            <span class="block text-[11px] font-semibold text-[#66706d]"
              >Tiempo recuperado</span
            >
            <strong class="my-2 block font-display text-[28px] tracking-tight"
              >26 h</strong
            >
            <small class="text-[9px] font-semibold text-velyon-deep"
              >Gracias a automatizaciones</small
            >
          </article>
        </div>

        <div class="mt-3 rounded-[14px] border border-[#e2e8e6] bg-white p-4">
          <div class="flex items-start justify-between">
            <div>
              <span
                class="block text-[9px] font-bold uppercase tracking-wider text-[#77807d]"
                >Flujo activo</span
              ><strong class="mt-1 block text-[13px]">Nuevo cliente</strong>
            </div>
            <span
              class="rounded-full bg-[#e8f8ef] px-2 py-1 text-[8px] font-bold uppercase text-[#238052]"
              >Activo</span
            >
          </div>
          <div
            class="mt-4 grid grid-cols-[1fr_auto_1fr_auto_1fr] items-center gap-1.5 max-[480px]:grid-cols-1"
          >
            {
              ["Formulario web", "Registro automático", "Seguimiento"].map(
                (item, index) => (
                  <>
                    <span class="flex items-center gap-1.5 rounded-lg bg-velyon-mist p-2 text-[8px] font-bold text-[#454d4a]">
                      <i class="grid size-4 place-items-center rounded bg-white not-italic text-velyon-deep">
                        {index + 1}
                      </i>
                      {item}
                    </span>
                    {index < 2 && (
                      <ArrowRight
                        class="size-3 text-[#aeb8b4] max-[480px]:hidden"
                        aria-hidden="true"
                      />
                    )}
                  </>
                ),
              )
            }
          </div>
        </div>

        <div
          class="mt-3 flex items-center justify-between rounded-[14px] border border-[#e2e8e6] bg-white px-4 py-3"
        >
          <div class="flex items-center gap-2.5">
            <span
              class="grid size-8 place-items-center rounded-lg bg-velyon-lavender-soft text-[9px] font-extrabold text-velyon-indigo"
              >VL</span
            ><p class="m-0">
              <strong class="block text-[10px]"
                >Nuevo contacto registrado</strong
              ><small class="mt-0.5 block text-[8px] text-[#77807d]"
                >Desde la página de servicios</small
              >
            </p>
          </div>
          <time class="text-[8px] text-[#8b9491]">Ahora</time>
        </div>
      </div>
    </div>

    <div
      class="soft-shadow absolute bottom-9 -left-3 z-20 flex items-center gap-2.5 rounded-[13px] border border-velyon-deep/10 bg-white px-3.5 py-3 max-[1100px]:left-0 max-[640px]:hidden"
    >
      <span
        class="grid size-8 place-items-center rounded-lg bg-velyon-mint text-velyon-deep"
        ><Plus class="size-4" /></span
      >
      <div>
        <strong class="block text-[11px]">Todo conectado</strong><small
          class="mt-0.5 block text-[8px] text-muted-foreground"
          >Web, ventas y operación</small
        >
      </div>
    </div>
    <div
      class="soft-shadow absolute right-0 top-3 z-20 grid size-28 place-items-center rounded-[26px] border border-velyon-deep/10 bg-white/95 max-[640px]:hidden"
    >
      <LottieAnimation
        class="size-full"
        label="Tecnología conectando procesos"
      />
    </div>
  </div>
</section>

<section
  class="border-y border-border bg-velyon-mist"
  aria-label="Áreas de especialidad"
>
  <div
    class="container-velyon flex min-h-[90px] items-center justify-between gap-8 max-[680px]:flex-col max-[680px]:items-start max-[680px]:justify-center max-[680px]:py-6"
  >
    <span
      class="max-w-[270px] text-[11px] font-bold uppercase leading-4 tracking-[0.08em] text-muted-foreground"
      >Diseñado para negocios que quieren dar el siguiente paso</span
    >
    <div
      class="flex flex-wrap items-center justify-end gap-x-6 gap-y-2 text-[13px] font-bold text-[#323a37] max-[680px]:justify-start max-[680px]:gap-x-3"
    >
      {
        ["Web", "Comercio digital", "Automatización", "Sistemas"].map(
          (item, index) => (
            <>
              <span>{item}</span>
              {index < 3 && <i class="size-1 rounded-full bg-velyon-mint" />}
            </>
          ),
        )
      }
    </div>
  </div>
</section>
