---
import {
  ArrowRight,
  Check,
  Mail,
  MessageCircle,
  ClipboardCheck,
  Sparkles,
  Target,
} from "@lucide/astro";

import { siteConfig, whatsappUrl } from "@/lib/site";
---

<section
  id="contacto"
  class="bg-velyon-deep py-[120px] text-white max-[640px]:py-20"
>
  <div
    class="container-velyon grid grid-cols-[.85fr_1.15fr] items-center gap-20 max-[900px]:grid-cols-1"
  >
    <!-- IZQUIERDA -->

    <div>
      <span
        class="mb-5 block text-[11px] font-extrabold uppercase tracking-[0.14em] text-velyon-mint"
      >
        08 — Conversemos
      </span>

      <h2
        class="font-display text-[clamp(2.4rem,4vw,3.5rem)] font-bold leading-[1.05] tracking-[-0.055em]"
      >
        Antes de crear una solución,
        <span class="font-serif italic text-velyon-mint">
          entendamos tu negocio.
        </span>
      </h2>

      <p class="mt-6 max-w-[480px] text-[15px] leading-7 text-white/70">
        Cada negocio tiene procesos, objetivos y necesidades diferentes. Por eso
        creamos un diagnóstico inicial donde analizamos tu situación y
        encontramos oportunidades reales de mejora.
      </p>

      <!-- BENEFICIOS -->

      <div class="mt-8 grid gap-4">
        {
          [
            "Analizamos tu modelo de negocio",
            "Identificamos oportunidades digitales",
            "Proponemos una solución según tu objetivo",
          ].map((item) => (
            <div class="flex items-center gap-3">
              <span class="grid size-6 place-items-center rounded-full bg-velyon-mint/15 text-velyon-mint">
                <Check class="size-3.5" />
              </span>

              <span class="text-sm font-semibold text-white/85">{item}</span>
            </div>
          ))
        }
      </div>

      <!-- CONTACTO -->

      <div class="mt-10 flex flex-wrap gap-5">
        <a
          href={whatsappUrl}
          target="_blank"
          class="inline-flex items-center gap-2 text-sm font-bold text-velyon-mint transition hover:text-white"
        >
          <MessageCircle class="size-4" />

          WhatsApp
        </a>

        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex items-center gap-2 text-sm font-bold text-velyon-mint transition hover:text-white"
        >
          <Mail class="size-4" />

          {siteConfig.email}
        </a>
      </div>
    </div>

    <!-- DERECHA -->

    <div
      class="rounded-[30px] border border-white/15 bg-white/[0.08] p-8 backdrop-blur-sm sm:p-10"
    >
      <div class="flex items-start justify-between gap-5">
        <div>
          <span
            class="text-[10px] font-extrabold uppercase tracking-[0.15em] text-velyon-mint"
          >
            Diagnóstico inicial
          </span>

          <h3 class="mt-3 font-display text-2xl font-bold tracking-[-0.04em]">
            Cuéntanos qué quieres mejorar.
          </h3>
        </div>

        <span
          class="grid size-12 place-items-center rounded-xl bg-velyon-mint/15 text-velyon-mint"
        >
          <Sparkles class="size-5" />
        </span>
      </div>

      <!-- PASOS -->

      <div class="mt-8 grid gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <div class="flex gap-4">
            <span
              class="grid size-10 shrink-0 place-items-center rounded-xl bg-velyon-mint-soft text-velyon-deep"
            >
              <ClipboardCheck class="size-5" />
            </span>

            <div>
              <h4 class="font-bold">1. Completa el diagnóstico</h4>

              <p class="mt-1 text-sm leading-6 text-white/60">
                Cuéntanos sobre tu empresa, objetivos y necesidades.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <div class="flex gap-4">
            <span
              class="grid size-10 shrink-0 place-items-center rounded-xl bg-white/10 text-velyon-mint"
            >
              <Target class="size-5" />
            </span>

            <div>
              <h4 class="font-bold">2. Analizamos tu caso</h4>

              <p class="mt-1 text-sm leading-6 text-white/60">
                Revisamos oportunidades y definimos el camino adecuado.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->

      <a
        href="/diagnostico"
        class="mt-8 flex min-h-14 items-center justify-center gap-3 rounded-xl bg-velyon-mint px-6 text-sm font-extrabold text-velyon-deep transition hover:-translate-y-1 hover:bg-white"
      >
        Comenzar diagnóstico gratuito

        <ArrowRight class="size-4" />
      </a>

      <p class="mt-5 text-center text-xs text-white/50">
        Toma menos de 15 minutos · Sin compromiso
      </p>
    </div>
  </div>
</section>
