---
import {
  ArrowRight,
  BriefcaseBusiness,
  Building2,
  Compass,
  GraduationCap,
  HeartPulse,
  Scale,
  Sprout,
  Truck,
  UtensilsCrossed,
} from "@lucide/astro";

const featuredSectors = [
  {
    id: "educacion",
    number: "01",
    label: "Sector prioritario",
    title: "Educación",
    description:
      "Webs institucionales, plataformas de admisión, matrículas online y comunicación para colegios y academias.",
    icon: GraduationCap,
    featured: true,
    link: "Explorar soluciones educativas",
    href: "/sectores/educacion",
  },
  {
    id: "salud",
    number: "02",
    label: "Próximo vertical",
    title: "Salud",
    description:
      "Presencia digital profesional, agendamiento de citas y software a medida para consultorios y policlínicos.",
    icon: HeartPulse,
    featured: false,
    link: "Ver soluciones para salud",
    href: "/sectores/salud",
  },
  {
    id: "negocios",
    number: "03",
    label: "Soluciones prácticas",
    title: "Pymes y comercio",
    description:
      "Ventas por internet, catálogos digitales y orden operativo para empresas que crecen sin complicarse.",
    icon: BriefcaseBusiness,
    featured: false,
    link: "Ver soluciones para pymes",
    href: "/sectores/pymes-y-servicios",
  },
];

const otherSectors = [
  {
    title: "Servicios profesionales",
    detail: "Webs de autoridad y agendamiento para estudios de abogados, consultoras y arquitectos.",
    href: "/sectores/servicios-profesionales",
    icon: Scale,
  },
  {
    title: "Restaurantes y gastronomía",
    detail: "Menús interactivos y pedidos desglosados a WhatsApp sin pagar comisiones por plato.",
    href: "/sectores/restaurantes",
    icon: UtensilsCrossed,
  },
  {
    title: "Hoteles y turismo",
    detail: "Portales de reservas directas y catálogos de tours para hospedajes y agencias de viaje.",
    href: "/sectores/hoteles-turismo",
    icon: Compass,
  },
  {
    title: "Inmobiliarias y construcción",
    detail: "Portales de proyectos con planos, tipologías y captación directa de prospectos.",
    href: "/sectores/inmobiliarias",
    icon: Building2,
  },
  {
    title: "Logística y transporte",
    detail: "Cotizadores web de fletes, grúas y sistemas de seguimiento operativo de carga.",
    href: "/sectores/logistica-transporte",
    icon: Truck,
  },
  {
    title: "Agricultura y agroindustria",
    detail: "Sistemas a medida para acopio, pesaje de cosecha y presencia comercial exportadora.",
    href: "/sectores/agricultura",
    icon: Sprout,
  },
];
---

<section id="sectores" class="bg-velyon-mist py-[120px] max-[640px]:py-20">
  <div class="container-velyon">
    <div
      class="mb-14 grid grid-cols-[1.15fr_.7fr] items-end gap-20 max-[760px]:grid-cols-1 max-[760px]:gap-5"
    >
      <div>
        <span class="section-label">05 — Sectores</span><h2
          class="section-title"
        >
          Tecnología que habla el idioma de cada negocio.
        </h2>
      </div>
      <p class="mb-1 text-[15px] leading-7 text-muted-foreground">
        Cada sector tiene dinámicas distintas: desde pedidos por catálogo y cotización de fletes hasta
        agendamiento de citas médicas o admisión escolar. Diseñamos soluciones que se adaptan a la
        operativa real de tu rubro.
      </p>
    </div>

    <!-- 3 sectores destacados -->
    <div
      class="grid grid-cols-[1.25fr_.875fr_.875fr] gap-4 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1"
    >
      {
        featuredSectors.map((sector) => (
          <article
            id={sector.id}
            class:list={[
              "flex min-h-[370px] flex-col justify-between rounded-[22px] border p-7 max-[620px]:min-h-[300px]",
              sector.featured
                ? "border-transparent bg-velyon-lavender-soft max-[900px]:col-span-2 max-[620px]:col-span-1"
                : "border-border bg-white",
            ]}
          >
            <div class="flex justify-between text-[9px] font-extrabold uppercase tracking-[0.08em] text-velyon-deep">
              <>
                <span>{sector.label}</span>
                <span>{sector.number}</span>
              </>
            </div>
            <div>
              <span
                class:list={[
                  "mb-5 grid size-11 place-items-center rounded-xl",
                  sector.featured
                    ? "bg-white/70 text-velyon-indigo"
                    : "bg-velyon-mint-soft text-velyon-deep",
                ]}
              >
                <sector.icon class="size-5" aria-hidden="true" />
              </span>
              <h3 class="font-display text-[28px] font-bold tracking-[-0.04em]">
                {sector.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">
                {sector.description}
              </p>
              <a
                class="mt-5 inline-flex items-center gap-2 text-xs font-bold text-velyon-deep"
                href={sector.href}
              >
                {sector.link}{" "}
                <ArrowRight class="size-4" />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Otros sectores clave -->
    <div class="mt-8">
      <p class="mb-4 text-xs font-extrabold uppercase tracking-widest text-velyon-deep">
        Más sectores con soluciones a medida
      </p>
      <div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
        {
          otherSectors.map((sector) => (
            <a
              href={sector.href}
              class="group flex flex-col justify-between rounded-2xl border border-border bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-velyon-deep/20 hover:shadow-md"
            >
              <div>
                <div class="flex items-center gap-3">
                  <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-velyon-mist text-velyon-deep transition group-hover:bg-velyon-mint-soft">
                    <sector.icon class="size-4" />
                  </span>
                  <h4 class="font-display text-base font-bold text-foreground transition group-hover:text-velyon-deep">
                    {sector.title}
                  </h4>
                </div>
                <p class="mt-2.5 text-xs leading-5 text-muted-foreground">
                  {sector.detail}
                </p>
              </div>
              <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-velyon-deep">
                Ver sector <ArrowRight class="size-3.5 transition group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
