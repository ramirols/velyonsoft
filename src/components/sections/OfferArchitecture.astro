---
import { ArrowRight, Boxes, Building2, Wrench } from "@lucide/astro";
import { productLinks, sectorLinks, solutionLinks } from "@/data/navigation";
---

<section class="container-velyon py-24" aria-labelledby="oferta-title">
  <div class="max-w-[780px]">
    <span class="section-label">Cómo trabajamos</span>
    <h2 id="oferta-title" class="section-title">
      Tres formas distintas de encontrar lo que necesitas.
    </h2>
    <p class="mt-5 max-w-[680px] text-sm leading-7 text-muted-foreground">
      Las soluciones explican qué construimos; los sectores, cómo lo aplicamos a
      una industria; y los productos son plataformas concretas que se utilizan
      por suscripción.
    </p>
  </div>

  <div class="mt-14 grid grid-cols-[1.2fr_.8fr] gap-5 max-[860px]:grid-cols-1">
    <article class="border-t-2 border-velyon-deep bg-velyon-mist p-7 sm:p-9">
      <div class="flex items-center gap-3">
        <Wrench class="size-5 text-velyon-deep" aria-hidden="true" /><p
          class="text-xs font-extrabold uppercase tracking-[.15em] text-velyon-deep"
        >
          Soluciones · Qué construimos
        </p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-8 max-[560px]:grid-cols-1">
        {
          solutionLinks.map((item) => (
            <a
              href={item.href}
              class="group grid grid-cols-[34px_1fr_auto] items-start gap-3 border-t border-border py-5"
            >
              <span class="text-[10px] font-extrabold text-velyon-deep">
                {item.number}
              </span>
              <span>
                <>
                  <strong class="block font-display text-base">
                    {item.label}
                  </strong>
                  <small class="mt-1 block leading-5 text-muted-foreground">
                    {item.detail}
                  </small>
                </>
              </span>
              <ArrowRight
                class="mt-1 size-4 text-velyon-deep transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>
    </article>

    <article class="bg-velyon-deep p-7 text-white sm:p-9">
      <div class="flex items-center gap-3">
        <Building2 class="size-5 text-velyon-mint" aria-hidden="true" /><p
          class="text-xs font-extrabold uppercase tracking-[.15em] text-velyon-mint"
        >
          Sectores · Para quién
        </p>
      </div>
      <div class="mt-10 grid gap-1">
        {
          sectorLinks.map((item) => (
            <a href={item.href} class="group border-t border-white/15 py-5">
              <span class="flex items-center justify-between gap-4">
                <>
                  <strong class="font-display text-lg">{item.label}</strong>
                  <ArrowRight
                    class="size-4 text-velyon-mint transition-transform group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                </>
              </span>
              <small class="mt-2 block leading-5 text-white/55">
                {item.detail}
              </small>
            </a>
          ))
        }
      </div>
    </article>
  </div>

  <article
    class="mt-5 grid grid-cols-[.4fr_1fr_auto] items-center gap-8 border border-velyon-indigo/15 bg-velyon-lavender-soft p-7 max-[720px]:grid-cols-1 sm:p-9"
  >
    <div>
      <div class="flex items-center gap-3">
        <Boxes class="size-5 text-velyon-indigo" aria-hidden="true" /><p
          class="text-xs font-extrabold uppercase tracking-[.15em] text-velyon-indigo"
        >
          Productos · Software listo para usar
        </p>
      </div>
    </div>
    <div>
      <strong class="font-display text-2xl">{productLinks[0].label}</strong><p
        class="mt-2 text-sm leading-6 text-muted-foreground"
      >
        {productLinks[0].detail}
      </p><span
        class="mt-3 inline-block rounded-full border border-velyon-indigo/20 px-3 py-1 text-[10px] font-extrabold uppercase tracking-[.12em] text-velyon-indigo"
        >{productLinks[0].status}</span
      >
    </div>
    <a href={productLinks[0].href} class="btn-outline"
      >Ver producto <ArrowRight class="size-4" aria-hidden="true" /></a
    >
  </article>
</section>
