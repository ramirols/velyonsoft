---
import { ArrowRight } from "@lucide/astro";
import { Card, CardContent } from "@/components/ui/card";

const problems = [
  {
    number: "01",
    title: "Quiero conseguir más clientes",
    description:
      "Convierte tu presencia digital en una herramienta comercial clara y confiable.",
    link: "Ver presencia digital",
    href: "#presencia",
    featured: false,
  },
  {
    number: "02",
    title: "Quiero vender por internet",
    description:
      "Recibe pedidos y pagos con una experiencia simple para tu cliente y tu equipo.",
    link: "Ver ventas online",
    href: "#ventas",
    featured: true,
  },
  {
    number: "03",
    title: "Quiero trabajar con más orden",
    description:
      "Automatiza tareas y centraliza la información que hoy está dispersa.",
    link: "Ver automatización",
    href: "#automatizacion",
    featured: false,
  },
];
---

<section class="container-velyon py-[122px] max-[640px]:py-20">
  <div class="mx-auto mb-14 max-w-[770px] text-center max-[640px]:mb-10">
    <span class="section-label">01 — El punto de partida</span>
    <h2 class="section-title">
      No empiezas eligiendo tecnología. Empiezas resolviendo un problema.
    </h2>
  </div>

  <div class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1">
    {
      problems.map((problem) => (
        <Card
          className={`group min-h-[280px] transition duration-200 hover:-translate-y-1 hover:shadow-xl ${problem.featured ? "border-transparent bg-velyon-mint-soft" : "bg-white"}`}
        >
          <CardContent className="flex h-full flex-col p-7">
            <span class="text-[11px] font-extrabold text-velyon-deep">
              {problem.number}
            </span>
            <h3 class="mt-12 max-w-[290px] font-display text-2xl font-bold leading-tight tracking-[-0.035em]">
              {problem.title}
            </h3>
            <p class="mt-3 text-sm leading-7 text-muted-foreground">
              {problem.description}
            </p>
            <a
              class="mt-auto inline-flex items-center gap-2 pt-6 text-[13px] font-bold text-velyon-deep"
              href={problem.href}
            >
              {problem.link}{" "}
              <ArrowRight
                class="size-4 transition group-hover:translate-x-1"
                aria-hidden="true"
              />
            </a>
          </CardContent>
        </Card>
      ))
    }
  </div>
</section>
