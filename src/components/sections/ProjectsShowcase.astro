---
import { ArrowRight, ExternalLink } from "@lucide/astro";
import { projects } from "@/data/projects";

const featuredProjects = projects
  .filter((project) => project.featured)
  .slice(0, 3);

const stats = [
  {
    number: "+40",
    label: "proyectos desarrollados",
  },
  {
    number: "5+",
    label: "años creando soluciones",
  },
  {
    number: "10+",
    label: "sectores atendidos",
  },
];
---

<section class="bg-white py-[120px] max-[640px]:py-20">
  <div class="container-velyon">
    <div class="mb-16 grid grid-cols-[1fr_.65fr] items-end gap-20 max-[800px]:grid-cols-1 max-[800px]:gap-8">
      <div>
        <span class="section-label">
          04 — Proyectos
        </span>

        <h2 class="section-title mt-4">
          Soluciones digitales construidas
          para negocios
          <span class="font-serif italic text-velyon-deep">
            reales.
          </span>
        </h2>
      </div>

      <p class="text-[15px] leading-7 text-muted-foreground">
        Cada proyecto representa una necesidad distinta:
        crear presencia digital, mejorar procesos internos
        o construir herramientas que permitan crecer.
      </p>
    </div>

    <div class="mb-16 flex flex-wrap gap-4">
      {
        stats.map((stat) => (
          <div class="min-w-[180px] rounded-full border border-border bg-velyon-mist px-7 py-5">
            <strong class="font-display text-3xl font-bold text-velyon-deep">
              {stat.number}
            </strong>

            <span class="ml-3 text-sm font-semibold text-muted-foreground">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-12 gap-5">
      {
        featuredProjects.map((project, index) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "group relative overflow-hidden rounded-[28px] border border-border bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_25px_60px_rgba(20,50,44,.12)]",
              index === 0
                ? "col-span-7 row-span-2 min-h-[600px] max-[900px]:col-span-12"
                : "col-span-5 min-h-[285px] max-[900px]:col-span-6 max-[600px]:col-span-12",
            ]}
          >
            <!-- Imagen -->
            <div class="absolute inset-0 overflow-hidden bg-velyon-mist">
              {project.image && (
                <img
                  src={project.image}
                  alt={project.name}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              )}
            </div>

            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />

            <!-- Contenido -->
            <div class="relative flex h-full flex-col justify-end p-7 text-white">
              <div>
                <span class="rounded-full bg-white/15 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider backdrop-blur">
                  {project.category}
                </span>

                <h3
                  class:list={[
                    "mt-4 font-display font-bold tracking-[-0.04em]",
                    index === 0 ? "text-4xl" : "text-2xl",
                  ]}
                >
                  {project.name}
                </h3>

                <p class="mt-3 max-w-[420px] text-sm leading-6 text-white/75">
                  {project.description}
                </p>

                <div class="mt-5 flex items-center gap-2 text-xs font-bold text-white">
                  Ver proyecto
                  <ExternalLink class="size-4" />
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 text-sm font-bold text-velyon-deep"
      >
        Explorar todos los proyectos
        <ArrowRight class="size-4" />
      </a>
    </div>
  </div>
</section>