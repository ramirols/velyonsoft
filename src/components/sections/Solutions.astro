---
import {
  ArrowRight,
  Check,
  Globe,
  MonitorSmartphone,
  ShieldCheck,
  ShoppingBag,
  Smartphone,
  Workflow,
} from "@lucide/astro";

const solutions = [
  {
    id: "ventas",
    number: "01",
    tag: "Comercial",
    title: "Tiendas online y catálogos comerciales",
    description:
      "Catálogos digitales y tiendas optimizadas para presentar tus productos, recibir pedidos directos por WhatsApp y procesar cobros con claridad.",
    bullets: [
      "Catálogos y tiendas online de alta velocidad",
      "Pedidos conectados directamente a WhatsApp",
      "Integración de pagos y seguimiento comercial",
    ],
    icon: ShoppingBag,
    cardClass: "bg-velyon-mint-soft text-foreground",
    mutedClass: "text-[#55615d]",
    borderClass: "border-velyon-deep/15",
    href: "/soluciones/ventas-por-internet",
  },
  {
    id: "automatizacion",
    number: "02",
    tag: "Operaciones",
    title: "Sistemas de gestión y automatización",
    description:
      "Herramientas y paneles de control que eliminan tareas repetitivas, ordenan el flujo de trabajo y evitan la pérdida de información en hojas de cálculo.",
    bullets: [
      "Automatización de procesos y recordatorios",
      "Paneles de administración y CRM a medida",
      "Centralización operativa y control diario",
    ],
    icon: Workflow,
    cardClass: "bg-velyon-lavender-soft text-foreground",
    mutedClass: "text-[#55615d]",
    borderClass: "border-velyon-deep/15",
    href: "/soluciones/automatizacion-de-procesos",
  },
  {
    id: "software",
    number: "03",
    tag: "A medida",
    title: "Software a medida e integraciones",
    description:
      "Desarrollo de software y conexión entre herramientas que tu negocio ya utiliza, adaptado a la lógica única de tu operación.",
    bullets: [
      "Integración entre sistemas y APIs externas",
      "Desarrollo web y plataformas personalizadas",
      "Mantenimiento continuo y soporte técnico",
    ],
    icon: MonitorSmartphone,
    cardClass: "bg-velyon-deep text-white",
    mutedClass: "text-white/70",
    borderClass: "border-white/15",
    href: "/soluciones/software-a-medida",
  },
];

const additionalSolutions = [
  {
    title: "Desarrollo web corporativo",
    description: "Sitios web profesionales y landing pages con SEO técnico para captar prospectos.",
    href: "/soluciones/desarrollo-web",
    icon: Globe,
  },
  {
    title: "Aplicaciones móviles Android e iOS",
    description: "Apps para clientes finales y herramientas operativas para personal de campo.",
    href: "/soluciones/aplicaciones-moviles",
    icon: Smartphone,
  },
  {
    title: "Mantenimiento y evolución continua",
    description: "Monitoreo 24/7, copias de seguridad, seguridad y soporte directo con el desarrollador.",
    href: "/soluciones/mantenimiento-y-evolucion",
    icon: ShieldCheck,
  },
];
---

<section id="soluciones" class="bg-velyon-mist py-[120px] max-[640px]:py-20">
  <div class="container-velyon">
    <div
      class="mb-14 grid grid-cols-[1.15fr_.7fr] items-end gap-20 max-[760px]:grid-cols-1 max-[760px]:gap-5"
    >
      <div>
        <span class="section-label">02 — Soluciones</span><h2
          class="section-title"
        >
          Una oferta simple, organizada por resultados comerciales.
        </h2>
      </div>
      <p class="mb-1 text-[15px] leading-7 text-muted-foreground">
        No necesitas saber qué herramienta usar. Primero entendemos el objetivo de tu negocio
        y después diseñamos la solución tecnológica adecuada.
      </p>
    </div>

    <!-- Tarjetas de soluciones principales -->
    <div
      class="grid grid-cols-3 gap-4 max-[900px]:mx-auto max-[900px]:max-w-[620px] max-[900px]:grid-cols-1"
    >
      {
        solutions.map((solution) => (
          <article
            id={solution.id}
            class:list={[
              "flex min-h-[520px] flex-col rounded-[22px] p-8 max-[900px]:min-h-[450px]",
              solution.cardClass,
            ]}
          >
            <div class="flex items-center justify-between text-[11px] font-extrabold">
              <span>{solution.number}</span>
              <span
                class:list={[
                  "rounded-full border px-2.5 py-1.5 text-[9px] uppercase tracking-[0.08em]",
                  solution.borderClass,
                ]}
              >
                {solution.tag}
              </span>
            </div>
            <span
              class:list={[
                "mt-14 grid size-11 place-items-center rounded-xl",
                solution.id === "automatizacion"
                  ? "bg-white/10 text-velyon-mint"
                  : "bg-white/70 text-velyon-deep",
              ]}
            >
              <solution.icon
                class="size-5"
                stroke-width="1.8"
                aria-hidden="true"
              />
            </span>
            <h3 class="mt-5 max-w-[270px] font-display text-[31px] font-bold leading-[1.08] tracking-[-0.045em]">
              {solution.title}
            </h3>
            <p
              class:list={[
                "mt-4 min-h-[76px] text-sm leading-7",
                solution.mutedClass,
              ]}
            >
              {solution.description}
            </p>
            <ul
              class:list={[
                "my-7 grid gap-3 border-y py-5",
                solution.borderClass,
              ]}
            >
              {solution.bullets.map((bullet) => (
                <li class="flex items-center gap-2.5 text-xs font-semibold">
                  <span
                    class:list={[
                      "check-dot",
                      solution.id === "automatizacion" && "bg-velyon-mint",
                    ]}
                  >
                    <Check class="size-3" stroke-width="3" aria-hidden="true" />
                  </span>
                  {bullet}
                </li>
              ))}
            </ul>
            <a
              class="mt-auto inline-flex items-center gap-2 text-[13px] font-bold"
              href={solution.href}
            >
              Conocer la solución{" "}
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>

    <!-- Soluciones complementarias para cobertura integral de enlazado -->
    <div class="mt-6 grid grid-cols-3 gap-4 max-[900px]:mx-auto max-[900px]:max-w-[620px] max-[900px]:grid-cols-1">
      {
        additionalSolutions.map((item) => (
          <a
            href={item.href}
            class="group flex items-center justify-between rounded-2xl border border-border bg-white p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-velyon-deep/20 hover:shadow-md"
          >
            <div class="flex items-center gap-3.5">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-velyon-mist text-velyon-deep transition group-hover:bg-velyon-mint-soft">
                <item.icon class="size-5" />
              </span>
              <div>
                <span class="block text-sm font-bold text-foreground transition group-hover:text-velyon-deep">
                  {item.title}
                </span>
                <p class="text-xs text-muted-foreground line-clamp-1">
                  {item.description}
                </p>
              </div>
            </div>
            <ArrowRight class="size-4 shrink-0 text-muted-foreground transition group-hover:translate-x-1 group-hover:text-velyon-deep" />
          </a>
        ))
      }
    </div>
  </div>
</section>
