---
import {
  ArrowRight,
  Check,
  GraduationCap,
  Users,
  WalletCards,
} from "@lucide/astro";
import { Badge } from "@/components/ui/badge";
---

<section id="productos" class="container-velyon py-[122px] max-[640px]:py-20">
  <div
    class="grid min-h-[550px] grid-cols-[.9fr_1.1fr] overflow-hidden rounded-[28px] bg-velyon-deep text-white max-[900px]:grid-cols-1 max-[640px]:rounded-[22px]"
  >
    <div class="p-[70px_58px] max-[640px]:p-8">
      <span class="section-label text-velyon-mint">03 — Productos Velyon</span>
      <Badge variant="outline" className="my-3 border-white/25 text-velyon-mint"
        >En validación</Badge
      >
      <h2
        class="mt-5 font-display text-[clamp(2.4rem,4vw,3.4rem)] font-bold leading-[1.08] tracking-[-0.052em]"
      >
        Soluciones que se convierten en productos.
      </h2>
      <p class="my-6 max-w-[480px] text-[15px] leading-7 text-white/70">
        Cuando un problema se repite en un sector, lo transformamos en una
        plataforma por suscripción: más accesible, especializada y lista para
        crecer.
      </p>
      <a class="btn-light" href="#contacto"
        >Quiero ser cliente piloto <ArrowRight
          class="size-4"
          aria-hidden="true"
        /></a
      >
    </div>

    <div
      class="soft-shadow m-[52px_52px_52px_0] self-center rotate-[1.2deg] rounded-[22px] border border-white/25 bg-[#fbfcfc] p-7 text-foreground max-[900px]:m-[0_42px_48px] max-[640px]:m-[0_18px_24px] max-[640px]:rotate-0 max-[640px]:p-5"
    >
      <div class="flex items-center gap-3 border-b border-border pb-5">
        <span
          class="grid size-11 place-items-center rounded-xl bg-velyon-lavender-soft text-velyon-indigo"
          ><GraduationCap class="size-5" aria-hidden="true" /></span
        >
        <div>
          <strong class="block text-sm">Velyon Educación</strong><small
            class="mt-0.5 block text-[10px] text-muted-foreground"
            >Gestión simple para instituciones</small>
        </div>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-3 max-[420px]:grid-cols-1">
        <div class="rounded-[14px] bg-velyon-mist p-4">
          <span
            class="flex items-center gap-1.5 text-[10px] text-muted-foreground"
            ><Users class="size-3" /> Estudiantes</span
          ><strong class="my-2 block font-display text-[27px] text-velyon-deep"
            >328</strong
          ><small class="text-[8px] text-[#7b8581]">12 nuevos este mes</small>
        </div>
        <div class="rounded-[14px] bg-velyon-mist p-4">
          <span
            class="flex items-center gap-1.5 text-[10px] text-muted-foreground"
            ><WalletCards class="size-3" /> Pagos al día</span
          ><strong class="my-2 block font-display text-[27px] text-velyon-deep"
            >91%</strong
          ><small class="text-[8px] text-[#7b8581]">+8% este periodo</small>
        </div>
      </div>
      <div class="mt-5 rounded-[14px] border border-border px-4 py-3">
        {
          [
            "Matrícula y registro centralizado",
            "Pensiones y recordatorios",
            "Comunicación con familias",
          ].map((item) => (
            <p class="my-2 flex items-center gap-2 text-[11px] font-semibold text-[#414a47]">
              <Check class="size-3.5 text-velyon-deep" stroke-width="3" />{" "}
              {item}
            </p>
          ))
        }
      </div>
    </div>
  </div>
  <p
    class="mx-auto mt-5 max-w-[850px] text-center text-[11px] leading-5 text-muted-foreground"
  >
    <strong>Recomendación:</strong> “Productos” permanece como una línea en desarrollo;
    cada producto tendrá página propia cuando exista una versión validada y clientes
    activos.
  </p>
</section>
