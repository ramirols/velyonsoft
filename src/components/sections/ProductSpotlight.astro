---
import {
  ArrowRight,
  Check,
  ExternalLink,
  MessageSquare,
  MonitorSmartphone,
  Smartphone,
  CalendarDays,
  Package,
  Workflow,
  UsersRound,
} from "@lucide/astro";

import { productLinks } from "@/data/navigation";
import { whatsappUrl } from "@/lib/site";

const product = productLinks.find((item) => item.featured) ?? productLinks.at(0);

const features = product?.features ?? [];

const platforms = product?.platforms ?? [];
---

{
  product && (
    <section
      id="productos"
      class="bg-white py-24 sm:py-28"
      aria-labelledby="product-spotlight-title"
    >
      <div class="container-velyon">
        <!-- Header -->
        <div class="mx-auto mb-14 max-w-[720px] text-center">
          <span class="section-label">03 — Software Vertical en Validación</span>

          <h2 id="product-spotlight-title" class="section-title">
            Software propio para sectores con{" "}
            <span class="font-serif font-medium italic text-velyon-deep">
              necesidades específicas.
            </span>
          </h2>

          <p class="mx-auto mt-5 max-w-[640px] text-base leading-7 text-muted-foreground">
            Diseñamos y validamos herramientas digitales para nichos profesionales,
            resolviendo flujos operativos reales con software moderno antes de escalar comercialmente.
          </p>
        </div>

        <!-- Producto -->
        <article
          class="mx-auto grid max-w-[1120px] grid-cols-[minmax(0,.9fr)_minmax(420px,1.1fr)] overflow-hidden rounded-[26px] border border-velyon-deep/10 bg-white shadow-[0_24px_70px_rgba(20,50,44,.08)] max-[880px]:grid-cols-1"
        >
          <!-- Información -->
          <div class="flex flex-col justify-between p-8 sm:p-10 lg:p-12">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-[10px] font-extrabold uppercase tracking-[.17em] text-velyon-deep">
                  {product.label}
                </span>

                <span class="rounded-full border border-velyon-indigo/15 bg-velyon-lavender-soft px-3 py-1 text-[9px] font-extrabold uppercase tracking-[.12em] text-velyon-indigo">
                  {product.status}
                </span>
              </div>

              <h3 class="mt-7 max-w-[520px] font-display text-[clamp(2rem,3.5vw,3.1rem)] font-bold leading-[1.05] tracking-[-0.052em] text-velyon-ink">
                {product.hero}
              </h3>

              <p class="mt-5 max-w-[520px] text-sm leading-7 text-muted-foreground">
                {product.detail}
              </p>

              <!-- Plataformas -->
              <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 border-y border-border py-4">
                {platforms.map((platform, index) => (
                  <span class="flex items-center gap-2 text-xs font-bold text-velyon-ink/70">
                    {index === 0 ? (
                      <MonitorSmartphone
                        class="size-4 text-velyon-deep"
                        aria-hidden="true"
                      />
                    ) : (
                      <Smartphone
                        class="size-4 text-velyon-deep"
                        aria-hidden="true"
                      />
                    )}

                    {platform}
                  </span>
                ))}
              </div>

              <!-- Características -->
              <ul
                class="mt-7 grid grid-cols-2 gap-x-5 gap-y-3 max-[480px]:grid-cols-1"
                aria-label="Características principales"
              >
                {features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-xs font-semibold leading-5 text-velyon-ink/70">
                    <Check
                      class="mt-0.5 size-3.5 shrink-0 text-velyon-deep"
                      stroke-width="2.8"
                    />

                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Acciones -->
            <div class="mt-9 flex flex-wrap items-center gap-3">
              {product.demoUrl ? (
                <>
                  <a
                    href={product.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary"
                  >
                    Ver demo en vivo
                    <ExternalLink class="size-4" aria-hidden="true" />
                  </a>

                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-velyon-deep/15 bg-white px-4 text-sm font-bold text-velyon-deep transition-colors hover:bg-velyon-mist hover:text-velyon-indigo"
                  >
                    <MessageSquare class="size-4" aria-hidden="true" />
                    Consultar por este software
                  </a>
                </>
              ) : (
                <>
                  <a href={product.href} class="btn-primary">
                    Conocer el producto
                    <ArrowRight class="size-4" aria-hidden="true" />
                  </a>

                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center justify-center px-4 text-sm font-bold text-velyon-deep transition-colors hover:text-velyon-indigo"
                  >
                    Solicitar información
                  </a>
                </>
              )}
            </div>
          </div>

          <!-- Preview -->
          <div class="flex items-center bg-velyon-mist p-6 sm:p-9 lg:p-11 max-[880px]:border-t max-[880px]:border-border">
            <div class="w-full">
              <div class="overflow-hidden rounded-[18px] border border-velyon-deep/10 bg-white shadow-[0_22px_55px_rgba(20,50,44,.12)]">
                <!-- Header ventana -->
                <div class="flex h-11 items-center border-b border-border px-4">
                  <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-[#ee8179]" />
                    <span class="size-1.5 rounded-full bg-[#e3b75e]" />
                    <span class="size-1.5 rounded-full bg-[#72bd91]" />
                  </div>

                  <span class="ml-auto text-[8px] font-bold uppercase tracking-[.14em] text-muted-foreground">
                    Demostración interactiva
                  </span>
                </div>

                <!-- Contenido dinámico -->
                <div class="min-h-[340px] p-6">
                  <div class="flex items-start justify-between">
                    <div>
                      <span class="text-[8px] font-bold uppercase tracking-[.12em] text-muted-foreground">
                        Proyecto en validación
                      </span>

                      <h4 class="mt-1 font-display text-lg font-bold tracking-[-0.025em] text-velyon-ink">
                        {product.label}
                      </h4>
                    </div>

                    <span class="rounded-full bg-velyon-mint-soft px-2.5 py-1 text-[8px] font-extrabold text-velyon-deep">
                      {product.status}
                    </span>
                  </div>

                  <div class="mt-8 grid gap-3">
                    {product.type === "health" && (
                      <>
                        <div class="flex items-center gap-3 rounded-xl border border-border p-4">
                          <CalendarDays class="size-5 text-velyon-deep shrink-0" />

                          <div>
                            <strong class="block text-sm">
                              Agenda inteligente semanal
                            </strong>

                            <span class="text-xs text-muted-foreground">
                              Citas por turnos y control de disponibilidad
                            </span>
                          </div>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl border border-border p-4">
                          <Workflow class="size-5 text-velyon-deep shrink-0" />

                          <div>
                            <strong class="block text-sm">
                              Fichas y notas clínicas
                            </strong>

                            <span class="text-xs text-muted-foreground">
                              Historial de sesiones y evolución estructurada
                            </span>
                          </div>
                        </div>
                      </>
                    )}

                    {product.type === "inventory" && (
                      <div class="flex items-center gap-3 rounded-xl border border-border p-4">
                        <Package class="size-5 text-velyon-deep shrink-0" />

                        <div>
                          <strong class="block text-sm">
                            Control de inventario
                          </strong>

                          <span class="text-xs text-muted-foreground">
                            Stock actualizado en tiempo real
                          </span>
                        </div>
                      </div>
                    )}

                    {product.type === "business" && (
                      <div class="flex items-center gap-3 rounded-xl border border-border p-4">
                        <Workflow class="size-5 text-velyon-deep shrink-0" />

                        <div>
                          <strong class="block text-sm">
                            Procesos conectados
                          </strong>

                          <span class="text-xs text-muted-foreground">
                            Gestión empresarial digital
                          </span>
                        </div>
                      </div>
                    )}

                    <div class="flex items-center gap-3 rounded-xl bg-velyon-mint-soft p-4">
                      <UsersRound class="size-5 text-velyon-deep shrink-0" />

                      <div>
                        <strong class="block text-sm">
                          Acceso a demostración
                        </strong>

                        <span class="text-xs text-muted-foreground">
                          Prueba la navegación y flujos sin costo
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <p class="mt-4 text-[10px] font-semibold text-muted-foreground">
                Software vertical desarrollado por VelyonSoft, en proceso de adopción y prueba con consultorios.
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>
  )
}