---
import { Check, MessageSquare } from "@lucide/astro";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
} from "@/components/ui/card";
import { whatsappUrl } from "@/lib/site";

const plans = [
  {
    type: "Pago único",
    title: "Implementación",
    description:
      "Desarrollo de tiendas online, sistemas o automatizaciones con alcance técnico cerrado y cronograma.",
    prefix: "Inversión inicial",
    price: "Desde S/ 1,200",
    suffix: "pago por proyecto según alcance",
    bullets: [
      "Diagnóstico técnico y arquitectura",
      "Desarrollo, pruebas y puesta en producción",
      "Entrega completa y capacitación de uso",
    ],
    cta: "Cotizar por WhatsApp",
    featured: true,
  },
  {
    type: "Tu propiedad",
    title: "Infraestructura",
    description:
      "El dominio, cuentas en la nube y licencias se configuran a nombre del cliente, garantizando control total.",
    prefix: "Costo directo",
    price: "Al costo",
    suffix: "pagado directamente a proveedores",
    bullets: [
      "Dominio y hosting a nombre de tu empresa",
      "Sin secuestro tecnológico ni dependencias",
      "Asesoría para elegir el plan más eficiente",
    ],
    cta: "Consultar arquitectura",
    featured: false,
  },
  {
    type: "Opcional mensual",
    title: "Mantenimiento básico",
    description:
      "Acompañamiento técnico posterior al lanzamiento para ajustes menores de contenido y consultas operativas.",
    prefix: "Continuidad",
    price: "Desde S/ 149",
    suffix: "al mes (alcance acordado en propuesta)",
    bullets: [
      "Ajustes menores de textos, imágenes y datos",
      "Atención directa a consultas técnicas",
      "Nuevas funciones o cambios mayores se cotizan aparte",
    ],
    cta: "Consultar mantenimiento",
    featured: false,
  },
];
---

<section id="planes" class="bg-velyon-mist py-[120px] max-[640px]:py-20">
  <div class="container-velyon">
    <div
      class="mb-14 grid grid-cols-[1.15fr_.7fr] items-end gap-20 max-[760px]:grid-cols-1 max-[760px]:gap-5"
    >
      <div>
        <span class="section-label">07 — Modalidades</span><h2
          class="section-title"
        >
          Una inversión inicial y continuidad sin sorpresas.
        </h2>
      </div>
      <p class="mb-1 text-[15px] leading-7 text-muted-foreground">
        La implementación se cotiza según el alcance. El mantenimiento posterior
        es opcional y los servicios de infraestructura (dominio/hosting) corren a
        nombre y costo directo del cliente.
      </p>
    </div>

    <div
      class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-1 max-[900px]:gap-6"
    >
      {
        plans.map((plan) => (
          <Card
            className={`relative h-full bg-white ${plan.featured ? "border-2 border-velyon-deep shadow-xl" : "border-border"}`}
          >
            {plan.featured && (
              <span class="absolute -top-3.5 right-6 rounded-full bg-velyon-mint px-3 py-2 text-[9px] font-extrabold uppercase tracking-[0.08em] text-velyon-deep-dark">
                Más recomendado
              </span>
            )}
            <CardHeader className="pb-3">
              <span class="text-[10px] font-extrabold uppercase tracking-[0.1em] text-velyon-deep">
                {plan.type}
              </span>
              <h3 class="font-display text-[27px] font-bold tracking-[-0.04em]">
                {plan.title}
              </h3>
              <p class="min-h-[66px] text-[13px] leading-6 text-muted-foreground">
                {plan.description}
              </p>
            </CardHeader>
            <CardContent className="flex flex-1 flex-col">
              <div class="mb-6 border-b border-border pb-6">
                <span class="block text-[10px] text-muted-foreground">
                  {plan.prefix}
                </span>
                <strong class="my-1 block font-display text-[34px] font-bold tracking-[-0.045em] text-velyon-deep">
                  {plan.price}
                </strong>
                <small class="text-[10px] text-muted-foreground">
                  {plan.suffix}
                </small>
              </div>
              <ul class="grid gap-3">
                {plan.bullets.map((bullet) => (
                  <li class="flex items-center gap-2.5 text-xs text-[#414a47]">
                    <span class="check-dot">
                      <Check class="size-3" stroke-width="3" />
                    </span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </CardContent>
            <CardFooter>
              <a
                class={
                  plan.featured ? "btn-primary w-full" : "btn-outline w-full"
                }
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <MessageSquare class="size-4" aria-hidden="true" />
                {plan.cta}
              </a>
            </CardFooter>
          </Card>
        ))
      }
    </div>
    <div
      class="mt-8 rounded-2xl border border-velyon-deep/10 bg-white p-5 text-center text-xs text-muted-foreground shadow-sm"
    >
      <p>
        <strong class="text-velyon-deep">Transparencia técnica:</strong> Los
        servicios de dominio y hosting son facturados por los proveedores
        directamente a tu empresa para garantizar tu independencia. El soporte
        mensual es opcional y con alcance de horas claramente definido.
      </p>
    </div>
  </div>
</section>
