---
interface Props {
  inverted?: boolean;
  compact?: boolean;
}

const { inverted = false, compact = false } = Astro.props;
---

<a
  href="/"
  class="inline-flex rounded-lg focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-velyon-mint/30"
  aria-label="Velyon, ir al inicio"
>
  <img
    src={compact
      ? "/brand/isotipo-velyon-color.svg"
      : inverted
        ? "/brand/logo-velyon-white.svg"
        : "/brand/logo-velyon-color.svg"}
    width={compact ? 44 : 158}
    height={compact ? 44 : 42}
    alt={compact ? "Símbolo de Velyon" : "Velyon"}
    class:list={[compact ? "size-11" : "h-[42px] w-auto"]}
  />
</a>
