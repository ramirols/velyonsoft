---
import { Mail, MapPin } from "@lucide/astro";
import Logo from "@/components/Logo.astro";
import { siteConfig, socialNetworks } from "@/lib/site";
---

<footer class="bg-[#0b2924] pb-6 pt-[70px] text-white">
  <div
    class="container-velyon grid grid-cols-[1.5fr_repeat(3,1fr)] gap-[70px] max-[900px]:grid-cols-3 max-[640px]:grid-cols-2 max-[640px]:gap-x-6 max-[640px]:gap-y-10"
  >
    <div class="max-[900px]:col-span-3 max-[640px]:col-span-2">
      <Logo inverted />
      <p class="mt-4 max-w-[230px] text-xs leading-6 text-white/55">
        {siteConfig.tagline}
      </p>
    </div>
    <div class="grid content-start gap-3">
      <strong class="mb-1 text-xs">Soluciones</strong>
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/soluciones/presencia-digital">Presencia digital</a
      >
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/soluciones/ventas-por-internet">Ventas por internet</a
      >
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/soluciones/automatizacion-y-sistemas"
        >Automatización y sistemas</a
      >
    </div>
    <div class="grid content-start gap-3">
      <strong class="mb-1 text-xs">Sectores</strong>
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/sectores/educacion">Educación</a
      >
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/sectores/salud">Salud</a
      >
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/sectores/negocios-y-servicios">Negocios y servicios</a
      >
    </div>
    <div class="grid content-start gap-3">
      <strong class="mb-1 text-xs">Contacto</strong>
      <a
        class="flex items-center gap-2 text-[11px] text-white/55 hover:text-velyon-mint"
        href={`mailto:${siteConfig.email}`}
      >
        <Mail class="size-3.5" />
        {siteConfig.email}
      </a>
      <a
        class="text-[11px] text-white/55 hover:text-velyon-mint"
        href="/#contacto">Solicitar diagnóstico</a
      >
      <span class="flex items-center gap-2 text-[11px] text-white/55">
        <MapPin class="size-3.5" />
        {siteConfig.location}
      </span>

      <strong class="mt-4 block text-xs">Redes Sociales</strong>
      <ul class="mt-2 flex gap-3">
        {
          socialNetworks.map((network) => (
            <li>
              <a
                href={network.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={network.name}
                class="grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-white/5 hover:bg-white/10"
              >
                {network.icon === "instagram" && (
                  <svg class="size-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
                )}
                {network.icon === "facebook" && (
                  <svg class="size-4 fill-current" viewBox="0 0 24 24">
                    <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.592 9 4.415V8z" />
                  </svg>
                )}
                {network.icon === "linkedin" && (
                  <svg class="size-4 fill-current" viewBox="0 0 24 24">
                    <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div
    class="container-velyon mt-14 flex justify-between border-t border-white/10 pt-5 text-[9px] text-white/40 max-[520px]:flex-col max-[520px]:gap-2"
  >
    <span
      >© {new Date().getFullYear()} Velyon · {siteConfig.legalName}. Todos los
      derechos reservados.</span
    >
    <span>Privacidad · Términos</span>
  </div>
</footer>
